    pub fn policyVersion(self: AcpClient): string {
        let resp = self.tget(self.base + "/policy-store");
        if (resp.status.toCode() != 200) { return "?"; }
        let ver = json.asNumber(json.get(json.parse(resp.body), "version")) ?? 0;
        return (ver == 0) ? "none" : `v${ver}`;
    }
    pub fn policyAuthor(self: AcpClient): string {
        let resp = self.tget(self.base + "/policy-store");
        if (resp.status.toCode() != 200) { return "unknown"; }
        return json.asString(json.get(json.parse(resp.body), "author")) ?? "unknown";
    }

    // Pending approvals (holds awaiting a human decision).
    // Resolve a step-up hold, carrying the Approver token (dev-token fallback) so it works with RBAC on.
    pub fn resolveApproval(self: AcpClient, id: string, approve: bool, userAuth: string): DeployResult {
        let verb = approve ? "approve" : "deny";
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("Approver"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/approvals/" + id + "/" + verb, hdrs, "");
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        return DeployResult(true, verb + " " + id);
    }

    pub fn pendingApprovals(self: AcpClient): list.List<ApprovalRow> {
        let rows = list.List<ApprovalRow>();
        let resp = self.tget(self.base + "/approvals/pending");
        if (resp.status.toCode() != 200) { return rows; }
        let root = json.parse(resp.body);
        let pv = json.get(root, "pending");
        let arr = json.asArray(pv);
        if (arr == undefined) { return rows; }
        let n = arr.size();
        let i = 0;
        while (i < n) {
            let item = json.at(pv, i);
            let id = json.asString(json.get(item, "id")) ?? "";
            let tool = json.asString(json.get(item, "tool")) ?? "";
            rows.push(ApprovalRow(id, tool));
            i = i + 1;
        }
        return rows;
    }

    // G4: post-market monitoring summary (EU AI Act Art. 72), Export-gated.
    pub fn postMarket(self: AcpClient): PostMarket {
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("x-acp-tenant", self.tenant);
        let tok = self.authToken("Auditor");
        if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); }
        let resp = client.Http.request("GET", self.base + "/report/post-market", hdrs, "");
        if (resp.status.toCode() != 200) { return PostMarket(0, 0, 0, ""); }
        let v = json.parse(resp.body);
        let rt = json.get(v, "redteam");
        let rtStatus = "not run";
        if (json.asString(json.get(rt, "status")) != undefined) { rtStatus = json.asString(json.get(rt, "status")) ?? "not run"; }
        let drift = json.asArray(json.get(v, "drift"));
        let dc = 0;
        if (drift != undefined) { dc = drift.size(); }
        return PostMarket(
            json.asNumber(json.get(v, "total_events")) ?? 0,
            json.asNumber(json.get(v, "blocks")) ?? 0,
            dc,
            rtStatus);
    }

    // G2: the least-privilege policy proposal synthesised from observed traffic (EditPolicy read).
    pub fn policySuggest(self: AcpClient): SuggestInfo {
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("x-acp-tenant", self.tenant);
        let tok = self.authToken("PolicyAdmin");
        if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); }
        let resp = client.Http.request("GET", self.base + "/policy/suggest", hdrs, "");
        if (resp.status.toCode() != 200) { return SuggestInfo("", 0, 0, ""); }
        let v = json.parse(resp.body);
        let wbArr = json.asArray(json.get(v, "would_block"));
        let wb = "";
        if (wbArr != undefined) {
            let i = 0;
            while (i < wbArr.size()) {
                let t = json.asString(json.at(json.get(v, "would_block"), i)) ?? "";
                if (!string.eql(t, "")) { if (string.eql(wb, "")) { wb = t; } else { wb = wb + ", " + t; } }
                i = i + 1;
            }
        }
        return SuggestInfo(
            json.asString(json.get(v, "proposed")) ?? "",
            json.asNumber(json.get(v, "proposed_rules")) ?? 0,
            json.asNumber(json.get(v, "observed_decisions")) ?? 0,
            wb);
    }

    // Generic POST forwarder for assurance actions: sends the datastar signal body to a server path
    // with a role token; returns DeployResult(ok, message).
    pub fn forward(self: AcpClient, path: string, body: string, role: string, userAuth: string): DeployResult {
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken(role); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + path, hdrs, body);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable (HTTP " + `${resp.status.toCode()}` + ")"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        let id = json.asString(json.get(v, "id")) ?? "";
        return DeployResult(true, string.eql(id, "") ? "done" : "done (" + id + ")");
    }

    // GET a role-gated endpoint, returning the raw body (for the trust summary and auditor pack).
    pub fn getWithRole(self: AcpClient, path: string, role: string): string {
        let hdrs = client.Http.emptyHeaders(); hdrs.set("x-acp-tenant", self.tenant);
        let tok = self.authToken(role); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); }
        let resp = client.Http.request("GET", self.base + path, hdrs, "");
        if (resp.status.toCode() != 200) { return ""; }
        return resp.body;
    }

    // G18: fetch the signed auditor evidence pack (whole window) and summarise it.
    pub fn auditPack(self: AcpClient): DeployResult {
        let body = self.getWithRole("/audit/pack?from=0&to=99999999999999", "Auditor");
        if (string.eql(body, "")) { return DeployResult(false, "acp-server unreachable or not authorised"); }
        let v = json.parse(body);
        let count = json.asNumber(json.get(json.get(v, "body"), "count")) ?? 0;
        let sig = json.asString(json.get(v, "sig_hex")) ?? "";
        return DeployResult(true, "signed pack ready: " + `${count}` + " record(s), sig " + (string.eql(sig, "") ? "none" : "present") + " (verify with acp verify-pack)");
    }

    // G19: the signed public trust summary (a compact one-line view of the controls in force).
    pub fn trustSummary(self: AcpClient): string {
        let body = self.getWithRole("/trust", "Auditor");
        if (string.eql(body, "")) { return ""; }
        let sum = json.get(json.parse(body), "summary");
        let ctrls = json.get(sum, "controls");
        let authz = (json.asBool(json.get(ctrls, "resource_boundary_authorization")) ?? false) ? "on" : "off";
        let rbac = (json.asBool(json.get(ctrls, "rbac")) ?? false) ? "on" : "off";
        let ev = (json.asBool(json.get(ctrls, "tamper_evident_evidence")) ?? false) ? "on" : "off";
        let fw = (json.asBool(json.get(ctrls, "content_firewall")) ?? false) ? "on" : "off";
        let ha = (json.asBool(json.get(ctrls, "high_availability")) ?? false) ? "on" : "off";
        return "authz=" + authz + "  rbac=" + rbac + "  evidence=" + ev + "  firewall=" + fw + "  HA=" + ha;
    }

    // G3: draft a policy from an English description and return the draft + verification matrix as a
    // display struct. The caller reviews before deploying via the existing signed deploy path.
    pub fn authorPolicy(self: AcpClient, text: string, userAuth: string): DeployResult {
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("PolicyAdmin"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let bodyReq = "{\"text\":" + self.jstr(text) + "}";
        let resp = client.Http.request("POST", self.base + "/policy/author", hdrs, bodyReq);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "could not draft"); }
        let draft = json.asString(json.get(v, "draft")) ?? "";
        let mArr = json.asArray(json.get(v, "matrix"));
        let matrix = "";
        if (mArr != undefined) {
            let i = 0;
            while (i < mArr.size()) {
                let m = json.at(json.get(v, "matrix"), i);
                let line = (json.asString(json.get(m, "tool")) ?? "") + " -> " + (json.asString(json.get(m, "verdict")) ?? "");
                matrix = string.eql(matrix, "") ? line : matrix + "  |  " + line;
                i = i + 1;
            }
        }
        return DeployResult(true, "DRAFT:\n" + draft + "\nMATRIX: " + matrix);
    }

    // G2: approve the current proposal: fetch it and deploy it via the signed policy-store path.
    pub fn approveSuggestion(self: AcpClient, userAuth: string): DeployResult {
        let info = self.policySuggest();
        if (string.eql(info.proposed, "")) { return DeployResult(false, "no proposal available (no observed traffic yet)"); }
        let body = "{\"policy\":" + self.jstr(info.proposed) + ",\"author\":\"console-approved\"}";
        return self.deployRaw(body, userAuth);
    }

    // G1: oversight-quality profile of each approver (EU AI Act Art. 14). Export-gated read.
    pub fn oversightRows(self: AcpClient): list.List<OversightRow> {
        let rows = list.List<OversightRow>();
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("x-acp-tenant", self.tenant);
        let tok = self.authToken("Auditor");
        if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); }
        let resp = client.Http.request("GET", self.base + "/oversight", hdrs, "");
        if (resp.status.toCode() != 200) { return rows; }
        let av = json.get(json.parse(resp.body), "approvers");
        let arr = json.asArray(av);
        if (arr == undefined) { return rows; }
        let i = 0;
        while (i < arr.size()) {
            let a = json.at(av, i);
            let ratePctN = json.asNumber(json.get(a, "approve_rate_pct")) ?? 0;
            let ratePct = `${ratePctN}%`;
            let reasonsArr = json.asArray(json.get(a, "reasons"));
            let reasons = "";
            if (reasonsArr != undefined) {
                let k = 0;
                while (k < reasonsArr.size()) {
                    let r = json.asString(json.at(json.get(a, "reasons"), k)) ?? "";
                    if (!string.eql(r, "")) { if (string.eql(reasons, "")) { reasons = r; } else { reasons = reasons + "; " + r; } }
                    k = k + 1;
                }
            }
            rows.push(OversightRow(
                json.asString(json.get(a, "approver")) ?? "",
                json.asBool(json.get(a, "flagged")) ?? false,
                ratePct,
                json.asNumber(json.get(a, "median_latency_ms")) ?? 0,
                json.asNumber(json.get(a, "total")) ?? 0,
                reasons));
            i = i + 1;
        }
        return rows;
    }

    // Recent governed decisions for the evidence table.
    pub fn evidenceRows(self: AcpClient): list.List<EvidenceRow> {
        let rows = list.List<EvidenceRow>();
        // A5: the raw decision detail requires the SeeArgs capability (SecurityOfficer).
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("x-acp-tenant", self.tenant);
        let tok = self.authToken("SecurityOfficer");
        if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); }
        let resp = client.Http.request("GET", self.base + "/evidence/recent", hdrs, "");
        if (resp.status.toCode() != 200) { return rows; }
        let ev = json.get(json.parse(resp.body), "evidence");
        let arr = json.asArray(ev);
        if (arr == undefined) { return rows; }
        let i = 0;
        while (i < arr.size()) {
            let item = json.at(ev, i);
            let seqN = json.asNumber(json.get(item, "seq")) ?? 0;
            rows.push(EvidenceRow(
                `${seqN}`,
                json.asString(json.get(item, "tool")) ?? "?",
                json.asString(json.get(item, "resource")) ?? "-",
                json.asString(json.get(item, "verdict")) ?? "?",
                json.asString(json.get(item, "agent")) ?? "",
                json.asString(json.get(item, "principal")) ?? "-"));
            i = i + 1;
        }
        return rows;
    }

    // Violations feed (gap E1/E3): denials, step-ups and blocks reported by the enforcement points to
    // the control plane, newest first. Read-only over acp-server /events/recent.
    pub fn eventRows(self: AcpClient): list.List<EventRow> {
        let rows = list.List<EventRow>();
        let resp = self.tget(self.base + "/events/recent");
        if (resp.status.toCode() != 200) { return rows; }
        let ev = json.get(json.parse(resp.body), "events");
        let arr = json.asArray(ev);
        if (arr == undefined) { return rows; }
        let i = 0;
        while (i < arr.size()) {
            let item = json.at(ev, i);
            rows.push(EventRow(
                json.asString(json.get(item, "proxy")) ?? "-",
                json.asString(json.get(item, "agent")) ?? "-",
                json.asString(json.get(item, "tool")) ?? "?",
                json.asString(json.get(item, "verdict")) ?? "?",
                json.asString(json.get(item, "rule_id")) ?? "-",
                json.asString(json.get(item, "impact")) ?? "-",
                json.asString(json.get(item, "outcome")) ?? "-"));
            i = i + 1;
        }
        return rows;
    }

    // E2: central fleet-evidence, PEP decision records mirrored and re-verified by the control plane.
    pub fn ingestedRows(self: AcpClient): list.List<IngestedRow> {
        let rows = list.List<IngestedRow>();
        let resp = self.tget(self.base + "/evidence/ingested");
        if (resp.status.toCode() != 200) { return rows; }
        let ev = json.get(json.parse(resp.body), "records");
        let arr = json.asArray(ev);
        if (arr == undefined) { return rows; }
        let i = 0;
        while (i < arr.size()) {
            let item = json.at(ev, i);
            let recS = json.asString(json.get(item, "record")) ?? "{}";
            let recV = json.parse(recS);
            let tool = json.asString(json.get(recV, "tool")) ?? "-";
            rows.push(IngestedRow(
                json.asString(json.get(item, "pep")) ?? "-",
                json.asString(json.get(item, "verdict")) ?? "?",
                tool,
                json.asBool(json.get(item, "verified")) ?? false,
                json.asString(json.get(item, "decision_id")) ?? ""));
            i = i + 1;
        }
        return rows;
    }

    // Central content-firewall config (kept in the control-plane DB; PEPs fetch it).
    pub fn firewallStatus(self: AcpClient): FirewallCfg {
        let resp = self.tget(self.base + "/firewall/config");
        if (resp.status.toCode() != 200) { return FirewallCfg(false, false, "", false, "", false, 0, 0, false); }
        let v = json.parse(resp.body);
        let en = json.asBool(json.get(v, "enabled")) ?? false;
        let bs = json.asBool(json.get(v, "block_secrets")) ?? false;
        let model = json.asString(json.get(v, "model")) ?? "";
        let topicsV = json.get(v, "deny_topics");
        let arr = json.asArray(topicsV);
        let topics = "";
        if (arr != undefined) {
            let i = 0;
            while (i < arr.size()) {
                let t = json.asString(json.at(topicsV, i)) ?? "";
                topics = string.eql(topics, "") ? t : topics + ", " + t;
                i = i + 1;
            }
        }
        let scanUrl = json.asString(json.get(v, "scan_url")) ?? "";
        let boe = json.asBool(json.get(v, "block_on_scanner_error")) ?? false;
        let feedVer = json.asNumber(json.get(v, "feed_version")) ?? 0;
        let tsv = json.get(v, "threat_signatures");
        let tsArr = json.asArray(tsv);
        let tsCount = tsArr?.size() ?? 0;
        let tox = json.asBool(json.get(v, "block_toxicity")) ?? false;
        return FirewallCfg(en, bs, topics, !string.eql(model, ""), scanUrl, boe, feedVer, tsCount, tox);
    }

    pub fn setFirewall(self: AcpClient, enabled: bool, blockSecrets: bool, denyCsv: string, model: string, scanUrl: string, blockOnScannerError: bool, blockToxicity: bool, userAuth: string): DeployResult {
        let topics = list.List<string>();
        let parts = string.split(denyCsv, ",");
        let i = 0;
        while (i < parts.size()) {
            let t = string.trim(parts.get(i) ?? "");
            if (!string.eql(t, "")) { topics.push(t); }
            i = i + 1;
        }
        let arr = "";
        let k = 0;
        while (k < topics.size()) {
            let piece = self.jstr(topics.get(k) ?? "");
            arr = string.eql(arr, "") ? piece : arr + "," + piece;
            k = k + 1;
        }
        let enS = enabled ? "true" : "false";
        let bsS = blockSecrets ? "true" : "false";
        let boeS = blockOnScannerError ? "true" : "false";
        let toxS = blockToxicity ? "true" : "false";
        let body = "{\"enabled\":" + enS + ",\"block_secrets\":" + bsS + ",\"deny_topics\":[" + arr + "],\"model\":" + self.jstr(model) + ",\"scan_url\":" + self.jstr(scanUrl) + ",\"block_on_scanner_error\":" + boeS + ",\"block_toxicity\":" + toxS + "}";
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("FirewallAdmin"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/firewall/config", hdrs, body);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        return DeployResult(true, "content firewall config saved");
    }

    // Operator-authored firewall (interception) rules.
    pub fn firewallRules(self: AcpClient): list.List<FwRuleRow> {
        let rows = list.List<FwRuleRow>();
        let resp = self.tget(self.base + "/firewall/rules");
        if (resp.status.toCode() != 200) { return rows; }
        let rv = json.get(json.parse(resp.body), "rules");
        let arr = json.asArray(rv);
        if (arr == undefined) { return rows; }
        let i = 0;
        while (i < arr.size()) {
            let item = json.at(rv, i);
            let m = json.get(item, "match");
            let keys = list.List<string>();
            keys.push("host_exact"); keys.push("host_suffix"); keys.push("host_contains"); keys.push("sni"); keys.push("path_prefix"); keys.push("path_contains");
            let parts = "";
            let k = 0;
            while (k < keys.size()) {
                let key = keys.get(k) ?? "";
                let val = json.asString(json.get(m, key));
                if (val != undefined) {
                    parts = string.eql(parts, "") ? (key + "=" + (val ?? "")) : (parts + ", " + key + "=" + (val ?? ""));
                }
                k = k + 1;
            }
            let portN = json.asNumber(json.get(m, "port"));
            if (portN != undefined) {
                let ps = "port=" + `${portN ?? 0}`;
                parts = string.eql(parts, "") ? ps : (parts + ", " + ps);
            }
            rows.push(FwRuleRow(
                json.asString(json.get(item, "id")) ?? "",
                parts,
                json.asString(json.get(item, "action")) ?? "?",
                json.asString(json.get(item, "classify")) ?? ""));
            i = i + 1;
        }
        return rows;
    }

    pub fn addFirewallRule(self: AcpClient, matchKind: string, matchValue: string, pathPrefix: string, action: string, classify: string, userAuth: string): DeployResult {
        let body = "{" + self.jstr(matchKind) + ":" + self.jstr(matchValue);
        if (!string.eql(pathPrefix, "")) { body = body + ",\"path_prefix\":" + self.jstr(pathPrefix); }
        body = body + ",\"action\":" + self.jstr(action);
        if (!string.eql(classify, "")) { body = body + ",\"classify\":" + self.jstr(classify); }
        body = body + "}";
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("FirewallAdmin"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/firewall/rules", hdrs, body);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        return DeployResult(true, "rule added");
    }

    pub fn deleteFirewallRule(self: AcpClient, id: string, userAuth: string): DeployResult {
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("FirewallAdmin"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/firewall/rules/" + id + "/delete", hdrs, "{}");
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        return DeployResult(true, "rule removed");
    }

    fn tallyList(self: AcpClient, v: json.JsonValue, name: string): list.List<Tally> {
        let out = list.List<Tally>();
        let vv = json.get(v, name);
        let arr = json.asArray(vv);
        if (arr == undefined) { return out; }
        let i = 0;
        while (i < arr.size()) {
            let item = json.at(vv, i);
            let c = json.asNumber(json.get(item, "count")) ?? 0;
            out.push(Tally(json.asString(json.get(item, "key")) ?? "?", `${c}`));
            i = i + 1;
        }
        return out;
    }

    // Aggregated breach-and-violation report (policy denies/step-ups + firewall blocks), for Reports.
    pub fn violationReport(self: AcpClient): ViolReport {
        let empty = ViolReport("0", list.List<Tally>(), list.List<Tally>(), list.List<Tally>());
        let resp = self.tget(self.base + "/report/violations");
        if (resp.status.toCode() != 200) { return empty; }
        let v = json.parse(resp.body);
        let total = json.asNumber(json.get(v, "total")) ?? 0;
        return ViolReport(`${total}`, self.tallyList(v, "by_verdict"), self.tallyList(v, "by_rule"), self.tallyList(v, "by_pep"));
    }

    // Raw CSV of the violation records (forwarded by the console for a same-origin download).
    pub fn violationCsv(self: AcpClient): string {
        // A5: exporting the violation ledger requires the Export capability (Auditor).
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("x-acp-tenant", self.tenant);
        let tok = self.authToken("Auditor");
        if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); }
        let resp = client.Http.request("GET", self.base + "/report/violations.csv", hdrs, "");
        if (resp.status.toCode() != 200) { return "ts_ms,pep,agent,tool,verdict,rule_id,impact,outcome\n"; }
        return resp.body;
    }

    // Rules of the currently deployed policy, with app/agent resolved to registered names. Shows
    // "any" where a rule is not scoped to a specific app or agent. Read-only over the signed file.
    pub fn policyRules(self: AcpClient): list.List<PolicyRuleRow> {
        let rows = list.List<PolicyRuleRow>();
        let resp = self.tget(self.base + "/policy-store/rules");
        if (resp.status.toCode() != 200) { return rows; }
        let rv = json.get(json.parse(resp.body), "rules");
        let arr = json.asArray(rv);
        if (arr == undefined) { return rows; }
        let i = 0;
        while (i < arr.size()) {
            let item = json.at(rv, i);
            let agent = json.asString(json.get(item, "agent_label")) ?? "any";
            let principal = json.asString(json.get(item, "principal")) ?? "any";
            let resource = json.asString(json.get(item, "resource")) ?? "any";
            let operation = json.asString(json.get(item, "operation")) ?? "any";
            let obArr = json.asArray(json.get(item, "obligations"));
            let obs = "";
            if (obArr != undefined) {
                let j = 0;
                while (j < obArr.size()) {
                    let o = json.asString(json.at(json.get(item, "obligations"), j)) ?? "";
                    obs = string.eql(obs, "") ? o : obs + ", " + o;
                    j = j + 1;
                }
            }
            if (string.eql(obs, "")) { obs = "-"; }
            rows.push(PolicyRuleRow(
                json.asString(json.get(item, "id")) ?? "?",
                agent, principal, resource, operation,
                json.asString(json.get(item, "tool")) ?? "*",
                json.asString(json.get(item, "verdict")) ?? "allow",
                obs));
            i = i + 1;
        }
        return rows;
    }

    // Fetch a bearer token for a role. In dev this hits acp-server's mock /auth/dev-token; in a
    // real deployment the console shell performs an OIDC login and this returns the user's token.
    // Empty string when auth is not enabled (the server then runs RBAC-off and accepts the call).
    fn authToken(self: AcpClient, role: string): string {
        let resp = self.tget(self.base + "/auth/dev-token?role=" + role);
        if (resp.status.toCode() != 200) { return ""; }
        return json.asString(json.get(json.parse(resp.body), "token")) ?? "";
    }

    // Deploy a policy by forwarding the browser's datastar signals (which already carry a "policy"
    // and "author" field) straight to acp-server, the trust store. The server validates, versions,
    // signs, and writes it; we return the outcome for display.
    pub fn deployRaw(self: AcpClient, body: string, userAuth: string): DeployResult {
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        // Prefer the caller's real token (injected by an identity-aware proxy / OIDC login in front
        // of the console); fall back to a dev token only when none is present (local use).
        if (!string.eql(userAuth, "")) {
            hdrs.set("Authorization", userAuth);
        } else {
            let tok = self.authToken("PolicyAdmin");
            if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); }
        }
        let resp = client.Http.request("POST", self.base + "/policy-store/deploy", hdrs, body);
        if (resp.status.toCode() != 200) {
            return DeployResult(false, "acp-server unreachable (HTTP " + `${resp.status.toCode()}` + ")");
        }
        let v = json.parse(resp.body);
        let ok = json.asBool(json.get(v, "ok")) ?? false;
        if (ok) {
            let ver = json.asNumber(json.get(v, "version")) ?? 0;
            return DeployResult(true, "Deployed as v" + `${ver}`);
        }
        return DeployResult(false, json.asString(json.get(v, "error")) ?? "deploy rejected");
    }

    // Current break-glass / kill-switch status from acp-server.
    pub fn killStatus(self: AcpClient): KillStatus {
        let resp = self.tget(self.base + "/break-glass");
        if (resp.status.toCode() != 200) { return KillStatus(false, "", "", "", false); }
        let v = json.parse(resp.body);
        return KillStatus(
            json.asBool(json.get(v, "active")) ?? false,
            json.asString(json.get(v, "mode")) ?? "",
            json.asString(json.get(v, "scope")) ?? "",
            json.asString(json.get(v, "reason")) ?? "",
            json.asBool(json.get(v, "signed")) ?? false);
    }

    // Engage break-glass by forwarding the browser's datastar signals (mode/scope/reason/ttl_ms) to
    // acp-server, which writes the signed grant the proxy watches. The console holds no key.
    pub fn killEngageRaw(self: AcpClient, body: string, userAuth: string): DeployResult {
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) {
            hdrs.set("Authorization", userAuth);
        } else {
            let tok = self.authToken("BreakGlassOperator");
            if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); }
        }
        let resp = client.Http.request("POST", self.base + "/break-glass/engage", hdrs, body);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        let ok = json.asBool(json.get(v, "ok")) ?? false;
        if (ok) {
            let m = json.asString(json.get(v, "mode")) ?? "";
            let sc = json.asString(json.get(v, "scope")) ?? "";
            return DeployResult(true, "engaged " + m + " (" + sc + ")");
        }
        return DeployResult(false, json.asString(json.get(v, "error")) ?? "engage rejected");
    }

    pub fn killClear(self: AcpClient, userAuth: string): DeployResult {
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) {
            hdrs.set("Authorization", userAuth);
        } else {
            let tok = self.authToken("BreakGlassOperator");
            if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); }
        }
        let resp = client.Http.request("POST", self.base + "/break-glass/clear", hdrs, "{}");
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        return DeployResult(true, "break-glass cleared");
    }

    // JSON-escape a string value (backslash then quote), for building small request bodies safely.
    fn jstr(self: AcpClient, s: string): string {
        let a = string.replace(s, "\\", "\\\\");
        let b = string.replace(a, "\"", "\\\"");
        let c = string.replace(b, "\n", "\\n");
        let d = string.replace(c, "\r", "\\r");
        let e = string.replace(d, "\t", "\\t");
        return "\"" + e + "\"";
    }

    fn postJson(self: AcpClient, route: string, body: string, role: string, userAuth: string): DeployResult {
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) {
            hdrs.set("Authorization", userAuth);
        } else {
            let tok = self.authToken(role);
            if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); }
        }
        let resp = client.Http.request("POST", self.base + route, hdrs, body);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        let ok = json.asBool(json.get(v, "ok")) ?? false;
        if (!ok) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        return DeployResult(true, "");
    }

    // Register an application in the control-plane store. Returns the new id in the message.
    pub fn registerApp(self: AcpClient, name: string, owner: string, userAuth: string): DeployResult {
        let body = "{\"name\":" + self.jstr(name) + ",\"owner\":" + self.jstr(owner) + "}";
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("AppRegistrar"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/apps", hdrs, body);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        return DeployResult(true, "registered " + (json.asString(json.get(v, "id")) ?? ""));
    }

    // Register an agent under an app. Returns the one-time token in the message (shown once).
    pub fn registerAgent(self: AcpClient, appId: string, name: string, owner: string, metadata: string, userAuth: string): DeployResult {
        let meta = string.eql(metadata, "") ? "{}" : metadata;
        let body = "{\"app_id\":" + self.jstr(appId) + ",\"name\":" + self.jstr(name) + ",\"owner\":" + self.jstr(owner) + ",\"metadata\":" + meta + "}";
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("AppRegistrar"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/agents", hdrs, body);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        let id = json.asString(json.get(v, "id")) ?? "";
        let token = json.asString(json.get(v, "token")) ?? "";
        return DeployResult(true, id + " token: " + token + " (save it now, not shown again)");
    }

    // B1: deactivate (revoke) a registered agent via the control plane.
    pub fn deactivateAgent(self: AcpClient, id: string, userAuth: string): DeployResult {
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("AppRegistrar"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/agents/" + id + "/deactivate", hdrs, "{}");
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        return DeployResult(true, "deactivated " + id);
    }

    // B2: advance a GRC record status via the control plane (re-signed server-side).
    pub fn updateGrcStatus(self: AcpClient, id: string, status: string, userAuth: string): DeployResult {
        let body = "{\"status\":" + self.jstr(status) + "}";
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("GrcAuthor"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/grc/" + id + "/status", hdrs, body);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        return DeployResult(true, id + " -> " + status);
    }

    // Governance records (GRC): signed operator documents, from acp-server. Read-only.
    pub fn grcRows(self: AcpClient): list.List<GrcRow> {
        let rows = list.List<GrcRow>();
        let resp = self.tget(self.base + "/grc");
        if (resp.status.toCode() != 200) { return rows; }
        let rv = json.get(json.parse(resp.body), "records");
        let arr = json.asArray(rv);
        if (arr == undefined) { return rows; }
        let i = 0;
        while (i < arr.size()) {
            let item = json.at(rv, i);
            let controls = list.List<GrcControl>();
            let bodyStr = json.asString(json.get(item, "body")) ?? "{}";
            let bodyV = json.parse(bodyStr);
            let cl = json.get(bodyV, "checklist");
            let clArr = json.asArray(cl);
            if (clArr != undefined) {
                let k = 0;
                while (k < clArr.size()) {
                    let ci = json.at(cl, k);
                    controls.push(GrcControl(
                        json.asString(json.get(ci, "control_id")) ?? "",
                        json.asString(json.get(ci, "title")) ?? "",
                        json.asBool(json.get(ci, "done")) ?? false));
                    k = k + 1;
                }
            }
            let comments = list.List<GrcComment>();
            let gid = json.asString(json.get(item, "id")) ?? "";
            let cResp = self.tget(self.base + "/grc/" + gid + "/comments");
            if (cResp.status.toCode() == 200) {
                let cv = json.get(json.parse(cResp.body), "comments");
                let cArr = json.asArray(cv);
                if (cArr != undefined) {
                    let m = 0;
                    while (m < cArr.size()) {
                        let cm = json.at(cv, m);
                        comments.push(GrcComment(
                            json.asString(json.get(cm, "author")) ?? "",
                            json.asString(json.get(cm, "body")) ?? ""));
                        m = m + 1;
                    }
                }
            }
            rows.push(GrcRow(
                gid,
                json.asString(json.get(item, "kind")) ?? "",
                json.asString(json.get(item, "subject")) ?? "",
                json.asString(json.get(item, "title")) ?? "",
                json.asString(json.get(item, "status")) ?? "",
                json.asBool(json.get(item, "verified")) ?? false,
                json.asNumber(json.get(item, "verified_refs")) ?? 0,
                json.asNumber(json.get(item, "total_refs")) ?? 0,
                json.asString(json.get(item, "tier")) ?? "",
                json.asString(json.get(item, "stage")) ?? "",
                json.asString(json.get(item, "assignee")) ?? "",
                json.asNumber(json.get(item, "controls_done")) ?? 0,
                json.asNumber(json.get(item, "controls_total")) ?? 0,
                controls, comments));
            i = i + 1;
        }
        return rows;
    }

    // Create a signed governance record. Returns the new id in the message.
    pub fn createGrc(self: AcpClient, kind: string, subject: string, title: string, status: string, body: string, linkedRefs: string, userAuth: string): DeployResult {
        // linkedRefs is a raw JSON array string, e.g. [{"type":"decision","id":"d-1"}]. Advisory only; the
        // server reconciles each id against the ledger and never trusts the payload. Default to [].
        let refs = string.eql(linkedRefs, "") ? "[]" : linkedRefs;
        let jbody = "{\"kind\":" + self.jstr(kind) + ",\"subject\":" + self.jstr(subject) + ",\"title\":" + self.jstr(title) + ",\"status\":" + self.jstr(status) + ",\"body\":" + self.jstr(body) + ",\"linked_refs\":" + refs + "}";
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("GrcAuthor"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/grc", hdrs, jbody);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        return DeployResult(true, "created " + (json.asString(json.get(v, "id")) ?? "") + " (" + kind + ")");
    }

    // G1: advance a use-case record through its gated lifecycle (server enforces the gate).
    pub fn usecaseTransition(self: AcpClient, id: string, stage: string, userAuth: string): DeployResult {
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("GrcAuthor"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/grc/" + id + "/usecase/" + stage, hdrs, "{}");
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        return DeployResult(true, "stage -> " + stage);
    }

    // A1: run the EU AI Act assessment engine over a screening questionnaire. answersJson is a raw
    // JSON object of boolean flags, e.g. {"employment_or_education":true}. The server computes the
    // risk tier and the control checklist, and persists a signed record.
    pub fn assessGrc(self: AcpClient, subject: string, title: string, answersJson: string, assignee: string, dueMs: string, userAuth: string): DeployResult {
        let ans = string.eql(answersJson, "") ? "{}" : answersJson;
        let due = string.eql(dueMs, "") ? "0" : dueMs;
        let jbody = "{\"subject\":" + self.jstr(subject) + ",\"title\":" + self.jstr(title) + ",\"assignee\":" + self.jstr(assignee) + ",\"due_ms\":" + due + ",\"answers\":" + ans + "}";
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("GrcAuthor"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/grc/assess", hdrs, jbody);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        let nc = json.asNumber(json.get(v, "controls")) ?? 0;
        return DeployResult(true, `assessed ${subject} tier=${json.asString(json.get(v, "tier")) ?? ""} (${nc} controls)`);
    }

    // A1: set the assignee and due date on a record (workflow metadata).
    pub fn assignGrc(self: AcpClient, id: string, assignee: string, dueMs: string, userAuth: string): DeployResult {
        let due = string.eql(dueMs, "") ? "0" : dueMs;
        let jbody = "{\"assignee\":" + self.jstr(assignee) + ",\"due_ms\":" + due + "}";
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("GrcAuthor"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/grc/" + id + "/assign", hdrs, jbody);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        return DeployResult(true, "assigned to " + assignee);
    }

    // A1: toggle a control's done flag in a checklist (re-signs the record server-side).
    pub fn toggleControl(self: AcpClient, id: string, controlId: string, done: bool, userAuth: string): DeployResult {
        let jbody = "{\"done\":" + (done ? "true" : "false") + "}";
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) { hdrs.set("Authorization", userAuth); }
        else { let tok = self.authToken("GrcAuthor"); if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); } }
        let resp = client.Http.request("POST", self.base + "/grc/" + id + "/control/" + controlId, hdrs, jbody);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        if (!(json.asBool(json.get(v, "ok")) ?? false)) { return DeployResult(false, json.asString(json.get(v, "error")) ?? "rejected"); }
        return DeployResult(true, "updated " + controlId);
    }

    // Registered AI endpoints (agents/providers) and their disposition, from acp-server. Read-only.
    pub fn endpointsRows(self: AcpClient): list.List<EndpointRow> {
        let rows = list.List<EndpointRow>();
        let resp = self.tget(self.base + "/endpoints");
        if (resp.status.toCode() != 200) { return rows; }
        let ev = json.get(json.parse(resp.body), "endpoints");
        let arr = json.asArray(ev);
        if (arr == undefined) { return rows; }
        let i = 0;
        while (i < arr.size()) {
            let item = json.at(ev, i);
            rows.push(EndpointRow(
                json.asString(json.get(item, "endpoint")) ?? "",
                json.asString(json.get(item, "provider")) ?? "",
                json.asString(json.get(item, "kind")) ?? "",
                json.asString(json.get(item, "disposition")) ?? "",
                json.asString(json.get(item, "reason")) ?? "",
                json.asBool(json.get(item, "active")) ?? false));
            i = i + 1;
        }
        return rows;
    }

    // Register (enrol) an AI endpoint by forwarding the browser's datastar signals (endpoint,
    // disposition, reason) to acp-server, which classifies the provider and records a signed
    // disposition. The console holds no signing key; acp-server is the trust store.
    pub fn registerEndpointRaw(self: AcpClient, body: string, userAuth: string): DeployResult {
        let hdrs = client.Http.emptyHeaders();
        hdrs.set("Content-Type", "application/json"); hdrs.set("x-acp-tenant", self.tenant);
        if (!string.eql(userAuth, "")) {
            hdrs.set("Authorization", userAuth);
        } else {
            let tok = self.authToken("PolicyAdmin");
            if (!string.eql(tok, "")) { hdrs.set("Authorization", "Bearer " + tok); }
        }
        let resp = client.Http.request("POST", self.base + "/endpoints/register", hdrs, body);
        if (resp.status.toCode() != 200) { return DeployResult(false, "acp-server unreachable"); }
        let v = json.parse(resp.body);
        let ok = json.asBool(json.get(v, "ok")) ?? false;
        if (ok) {
            let ep = json.asString(json.get(v, "endpoint")) ?? "";
            let prov = json.asString(json.get(v, "provider")) ?? "";
            return DeployResult(true, "registered " + ep + " (" + prov + ")");
        }
        return DeployResult(false, json.asString(json.get(v, "error")) ?? "register rejected");
    }

    // Control-plane integrity and health, from acp-server's verifiable endpoints. Each figure is
    // served by acp-server and re-derivable from the signed evidence; the console only displays it.
    pub fn health(self: AcpClient): HealthStatus {
        let h = HealthStatus();
        let vr = self.tget(self.base + "/verify");
        if (vr.status.toCode() == 200) {
            h.reachable = true;
            let v = json.parse(vr.body);
            h.ledgerOk = json.asBool(json.get(v, "ok")) ?? false;
            let d = json.asString(json.get(v, "detail")) ?? "";
            h.ledgerDetail = string.eql(d, "") ? (h.ledgerOk ? "re-derived, signatures valid" : "verification failed") : d;
        }
        let lv = self.tget(self.base + "/liveness");
        if (lv.status.toCode() == 200) {
            let v = json.parse(lv.body);
            h.liveHealthy = json.asBool(json.get(v, "healthy")) ?? true;
            let g = json.asArray(json.get(v, "gaps"));
            if (g != undefined) { h.gaps = g.size(); }
        }
        let al = self.tget(self.base + "/alerts");
        if (al.status.toCode() == 200) {
            let v = json.parse(al.body);
            h.alertsHealthy = json.asBool(json.get(v, "healthy")) ?? true;
            let t = json.asArray(json.get(v, "tripped"));
            if (t != undefined) { h.tripped = t.size(); }
        }
        let ma = self.tget(self.base + "/meta-audit");
        if (ma.status.toCode() == 200) {
            let v = json.parse(ma.body);
            h.metaConfigured = json.asBool(json.get(v, "configured")) ?? false;
            h.metaSize = json.asNumber(json.get(v, "size")) ?? 0;
            h.metaVerified = json.asBool(json.get(v, "verified")) ?? false;
        }
        return h;
    }
}
