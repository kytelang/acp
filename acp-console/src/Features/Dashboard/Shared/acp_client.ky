// Reads ACP governance data from the acp-server JSON API. The console is a READ-ONLY view over the
// verifiable evidence: every figure is served by acp-server and re-derivable from the signed
// export, so the UI carries no trust (decision v1.3.1).
import web.client;
import web.response;
import serde.json;
import list;
import string;

pub struct AcpReport {
    pub reachable: bool,
    pub records: long,
    pub decisions: long,
    pub billable: long,
    pub coverage: double,
    pub allows: long,
    pub denies: long,
    pub stepUps: long,
    pub shadows: long,
    init() {
        self.reachable = false; self.records = 0; self.decisions = 0; self.billable = 0;
        self.coverage = 0.0; self.allows = 0; self.denies = 0; self.stepUps = 0; self.shadows = 0;
    }
}

// Control-plane health, read from acp-server's own endpoints (all already served, previously unused
// by the console): /verify (ledger re-derivation), /liveness (dead-man's-switch over proxy
// heartbeats), /alerts (spike detector), /meta-audit (self-governance log).
pub struct HealthStatus {
    pub reachable: bool,
    pub ledgerOk: bool,
    pub ledgerDetail: string,
    pub liveHealthy: bool,
    pub gaps: int,
    pub alertsHealthy: bool,
    pub tripped: int,
    pub metaConfigured: bool,
    pub metaSize: long,
    pub metaVerified: bool,
    init() {
        self.reachable = false; self.ledgerOk = false; self.ledgerDetail = "";
        self.liveHealthy = true; self.gaps = 0; self.alertsHealthy = true; self.tripped = 0;
        self.metaConfigured = false; self.metaSize = 0; self.metaVerified = false;
    }
}

