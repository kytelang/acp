        if (arr == undefined) { return rows; }
        let i = 0;
        while (i < arr.size()) {
            let c = json.at(cv, i);
            rows.push(DriftRow(
                json.asString(json.get(c, "class")) ?? "",
                json.asFloat(json.get(c, "rate")) ?? 0.0,
                json.asFloat(json.get(c, "baseline")) ?? 0.0,
                json.asBool(json.get(c, "drifted")) ?? false));
            i = i + 1;
        }
        return rows;
    }
    // F3: data-class -> tool lineage edges.
    pub fn lineageRows(self: AcpClient): list.List<LineageRow> {
        let rows = list.List<LineageRow>();
        let resp = self.tget(self.base + "/monitor/lineage");
