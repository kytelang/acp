import web.routing;
import serde.json;
import web.response;
import ds_response;
import Features.Dashboard.Shared.acp_client;
import Features.Dashboard.views.dashboard;

// POST /policy/deploy: the console forwards the browser's datastar signals (which carry a "policy"
// YAML body and an "author") to acp-server, the trust store. acp-server validates, versions, and
// signs the policy; the proxy hot-reloads it only after verifying that signature. The console holds
// no signing key and makes no policy decision: it is a submit form over the verifiable API.
pub struct DeployHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }

    async fn serve(self: DeployHandler, ctx: Context): Response {
        let auth = ctx.request.headers.get("authorization") ?? "";
        let res = self.acp.deployRaw(ctx.request.body, auth);
        // The live SSE stream refreshes the rules table and version badge on its next tick; here we
        // just report the immediate outcome next to the Deploy button.
        return await ds_response.patch(deployResultPanel(res));
    }
}

// POST /policy/approve-suggestion (G2): the operator approves the least-privilege proposal. The console
// fetches the current proposal from acp-server and deploys it via the signed policy-store path, so the
// deployed policy is versioned and signed. The human click is the explicit approval.
pub struct SuggestApproveHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }

    async fn serve(self: SuggestApproveHandler, ctx: Context): Response {
        let auth = ctx.request.headers.get("authorization") ?? "";
        let res = self.acp.approveSuggestion(auth);
        return await ds_response.patch(suggestResultPanel(res));
    }
}

// POST /policy/author-draft (G3): draft a policy from the operator's English description and show the
// draft plus the verification matrix (what it allows/blocks). Deploy stays a separate signed step.
pub struct AuthorHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }

    async fn serve(self: AuthorHandler, ctx: Context): Response {
        let auth = ctx.request.headers.get("authorization") ?? "";
        let text = json.stringField(ctx.request.body, "authorText");
        let res = self.acp.authorPolicy(text, auth);
        return await ds_response.patch(authorResultPanel(res));
    }
}
