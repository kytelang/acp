import web.app;
import web.request;
import net.aio;
import datastar;
import Features.Dashboard.Shared.acp_client;
import Features.Dashboard.views.dashboard;

// Live governance metrics over one SSE connection (decision v1.3.1 + datastar). Every ~2s it
// re-reads acp-server's /report and patches the #metrics fragment; the browser morphs it in place.
pub class MetricsSse impl SseHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }

    async fn stream(self: MetricsSse, req: request.Request, io: aio.AsyncIO): void {
        let ds = datastar.Sse.overStreamIO(io);
        let _h = await ds.writeHeaders();
        let alive = true;
        while (alive) {
            // Interleave fetch+write so the first paint lands after a single upstream call. The
            // health panel makes several blocking calls, so it is deferred to the end of the tick.
            let rep = self.acp.report();
            let w = await ds.patchElementsSimple(metricsPanel(rep));
            if (w < 0) { alive = false; }
            let w2 = await ds.patchElementsSimple(appsPanel(self.acp.appsRows()));
            if (w2 < 0) { alive = false; }
            let w3 = await ds.patchElementsSimple(agentsPanel(self.acp.agentsRows()));
            if (w3 < 0) { alive = false; }
            let w4 = await ds.patchElementsSimple(policyPanel(self.acp.policyVersion(), self.acp.policyAuthor()));
            if (w4 < 0) { alive = false; }
            let w5 = await ds.patchElementsSimple(approvalsPanel(self.acp.pendingApprovals()));
            if (w5 < 0) { alive = false; }
            let ev = self.acp.evidenceRows();
            let w6 = await ds.patchElementsSimple(evidencePanel(ev));
            if (w6 < 0) { alive = false; }
            let w7 = await ds.patchElementsSimple(policyRulesPanel(self.acp.policyRules()));
            if (w7 < 0) { alive = false; }
            let w8 = await ds.patchElementsSimple(killStatusPanel(self.acp.killStatus()));
            if (w8 < 0) { alive = false; }
            // Control-plane integrity (several calls) and the consolidated report, last.
            let health = self.acp.health();
            let w9 = await ds.patchElementsSimple(healthPanel(health));
            if (w9 < 0) { alive = false; }
            let w10 = await ds.patchElementsSimple(reportsPanel(rep, health, ev.size()));
            if (w10 < 0) { alive = false; }
            let w11 = await ds.patchElementsSimple(endpointsPanel(self.acp.endpointsRows()));
            if (w11 < 0) { alive = false; }
            let w12 = await ds.patchElementsSimple(grcPanel(self.acp.grcRows()));
            if (w12 < 0) { alive = false; }
            let w13 = await ds.patchElementsSimple(violationsPanel(self.acp.eventRows()));
            if (w13 < 0) { alive = false; }
            let w14 = await ds.patchElementsSimple(fleetEvidencePanel(self.acp.ingestedRows()));
            if (w14 < 0) { alive = false; }
            let w15 = await ds.patchElementsSimple(firewallStatusPanel(self.acp.firewallStatus()));
            if (w15 < 0) { alive = false; }
            let w16 = await ds.patchElementsSimple(firewallRulesPanel(self.acp.firewallRules()));
            if (w16 < 0) { alive = false; }
            let w17 = await ds.patchElementsSimple(violationReportPanel(self.acp.violationReport()));
            if (w17 < 0) { alive = false; }
            let w18 = await ds.patchElementsSimple(modelsPanel(self.acp.modelRows()));
            if (w18 < 0) { alive = false; }
            let w19 = await ds.patchElementsSimple(vendorsPanel(self.acp.vendorRows()));
            if (w19 < 0) { alive = false; }
            let w20 = await ds.patchElementsSimple(packsPanel(self.acp.packRows()));
            if (w20 < 0) { alive = false; }
            let w21 = await ds.patchElementsSimple(redteamPanel(self.acp.redteamRuns()));
            if (w21 < 0) { alive = false; }
            let w22 = await ds.patchElementsSimple(riskPanel(self.acp.riskRows()));
            if (w22 < 0) { alive = false; }
            let w23 = await ds.patchElementsSimple(modelCardsPanel(self.acp.modelCardRows()));
            if (w23 < 0) { alive = false; }
            let w24 = await ds.patchElementsSimple(driftPanel(self.acp.driftRows()));
            if (w24 < 0) { alive = false; }
            let w25 = await ds.patchElementsSimple(lineagePanel(self.acp.lineageRows()));
            if (w25 < 0) { alive = false; }
            let w26 = await ds.patchElementsSimple(tenantBadge(self.acp.tenant));
            if (w26 < 0) { alive = false; }
            if (alive) { await aio.delay(2000); }
        }
    }
}
