}

// POST /grc/{id}/control/{cid}/{done}: toggle a checklist control (re-signed server-side), then patch
// the refreshed GRC panel so the k/m progress updates.
pub struct ControlToggleHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: ControlToggleHandler, ctx: Context): Response {
        let acp = self.acp.withTenant(json.stringField(ctx.request.body, "tenant"));
        let auth = ctx.request.headers.get("authorization") ?? "";
        let id = ctx.param("id");
        let cid = ctx.param("cid");
        let done = string.eql(ctx.param("done"), "done");
        let _ = acp.toggleControl(id, cid, done, auth);
        return await ds_response.patch(grcPanel(acp.grcRows()));
    }
}


// POST /firewall/save: store the central content-firewall config (toggles, denied topics, ML model)
// in the control-plane DB; the enforcement points fetch it. Re-reads and patches the status.
pub struct FirewallSaveHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: FirewallSaveHandler, ctx: Context): Response {
        let acp = self.acp.withTenant(json.stringField(ctx.request.body, "tenant"));
        let auth = ctx.request.headers.get("authorization") ?? "";
        let en = json.stringField(ctx.request.body, "fwEnabled");
        let bs = json.stringField(ctx.request.body, "fwBlockSecrets");
        let topics = json.stringField(ctx.request.body, "fwDenyTopics");
        let model = json.stringField(ctx.request.body, "fwModel");
        let scanUrl = json.stringField(ctx.request.body, "fwScanUrl");
        let boe = json.stringField(ctx.request.body, "fwBlockOnScannerError");
        let tox = json.stringField(ctx.request.body, "fwBlockToxicity");
        let _ = acp.setFirewall(string.eql(en, "true"), string.eql(bs, "true"), topics, model, scanUrl, string.eql(boe, "true"), string.eql(tox, "true"), auth);
        return await ds_response.patch(firewallStatusPanel(acp.firewallStatus()));
    }
}


