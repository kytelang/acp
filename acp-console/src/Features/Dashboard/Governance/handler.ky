import web.routing;
import web.response;
import serde.json;
import string;
import ds_response;
import Features.Dashboard.Shared.acp_client;
import Features.Dashboard.views.dashboard;

// POST /grc/create: read the operator's datastar signals, forward a clean body to acp-server (which
// signs the record and stores it in the configured database), and patch the result.
pub struct CreateGrcHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: CreateGrcHandler, ctx: Context): Response {
        let auth = ctx.request.headers.get("authorization") ?? "";
        let kind = json.stringField(ctx.request.body, "grcKind");
        let subject = json.stringField(ctx.request.body, "grcSubject");
        let title = json.stringField(ctx.request.body, "grcTitle");
        let status = json.stringField(ctx.request.body, "grcStatus");
        let body = json.stringField(ctx.request.body, "grcBody");
        let res = self.acp.createGrc(kind, subject, title, status, body, auth);
        return await ds_response.patch(grcCreateResult(res));
    }
}


// POST /grc/{id}/to/{status}: advance a governance record status (re-signed server-side), then patch
// the refreshed GRC panel (B2).
pub struct GrcStatusHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: GrcStatusHandler, ctx: Context): Response {
        let auth = ctx.request.headers.get("authorization") ?? "";
        let id = ctx.param("id");
        let status = ctx.param("status");
        let _ = self.acp.updateGrcStatus(id, status, auth);
        return await ds_response.patch(grcPanel(self.acp.grcRows()));
    }
}


// POST /firewall/save: store the central content-firewall config (toggles, denied topics, ML model)
// in the control-plane DB; the enforcement points fetch it. Re-reads and patches the status.
pub struct FirewallSaveHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: FirewallSaveHandler, ctx: Context): Response {
        let auth = ctx.request.headers.get("authorization") ?? "";
        let en = json.stringField(ctx.request.body, "fwEnabled");
        let bs = json.stringField(ctx.request.body, "fwBlockSecrets");
        let topics = json.stringField(ctx.request.body, "fwDenyTopics");
        let model = json.stringField(ctx.request.body, "fwModel");
        let _ = self.acp.setFirewall(string.eql(en, "true"), string.eql(bs, "true"), topics, model, auth);
        return await ds_response.patch(firewallStatusPanel(self.acp.firewallStatus()));
    }
}
