import web.routing;
import web.response;
import serde.json;
import string;
import ds_response;
import Features.Dashboard.Shared.acp_client;
import Features.Dashboard.views.dashboard;

// POST /grc/create: read the operator's datastar signals, forward a clean body to acp-server (which
// signs the record and stores it in the configured database), and patch the result.
pub struct CreateGrcHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: CreateGrcHandler, ctx: Context): Response {
        let auth = ctx.request.headers.get("authorization") ?? "";
        let kind = json.stringField(ctx.request.body, "grcKind");
        let subject = json.stringField(ctx.request.body, "grcSubject");
        let title = json.stringField(ctx.request.body, "grcTitle");
        let status = json.stringField(ctx.request.body, "grcStatus");
        let body = json.stringField(ctx.request.body, "grcBody");
        // grcLinks is an operator-friendly comma-separated list of decision ids. We turn it into an
        // advisory JSON array; the server reconciles each id against the ledger and never trusts it.
        let links = json.stringField(ctx.request.body, "grcLinks");
        let refs = "[";
        let parts = string.split(links, ",");
        let n = 0;
        for (p in 0..parts.size()) {
            let id = string.trim(parts.get(p) ?? "");
            if (string.eql(id, "")) { continue; }
            if (n > 0) { refs = refs + ","; }
            refs = refs + "{\"type\":\"decision\",\"id\":\"" + id + "\"}";
            n = n + 1;
        }
        refs = refs + "]";
        let res = self.acp.createGrc(kind, subject, title, status, body, refs, auth);
        return await ds_response.patch(grcCreateResult(res));
    }
}


// POST /grc/{id}/to/{status}: advance a governance record status (re-signed server-side), then patch
// the refreshed GRC panel (B2).
pub struct GrcStatusHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: GrcStatusHandler, ctx: Context): Response {
        let auth = ctx.request.headers.get("authorization") ?? "";
        let id = ctx.param("id");
        let status = ctx.param("status");
        let _ = self.acp.updateGrcStatus(id, status, auth);
        return await ds_response.patch(grcPanel(self.acp.grcRows()));
    }
}


// POST /firewall/save: store the central content-firewall config (toggles, denied topics, ML model)
// in the control-plane DB; the enforcement points fetch it. Re-reads and patches the status.
pub struct FirewallSaveHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: FirewallSaveHandler, ctx: Context): Response {
        let auth = ctx.request.headers.get("authorization") ?? "";
        let en = json.stringField(ctx.request.body, "fwEnabled");
        let bs = json.stringField(ctx.request.body, "fwBlockSecrets");
        let topics = json.stringField(ctx.request.body, "fwDenyTopics");
        let model = json.stringField(ctx.request.body, "fwModel");
        let _ = self.acp.setFirewall(string.eql(en, "true"), string.eql(bs, "true"), topics, model, auth);
        return await ds_response.patch(firewallStatusPanel(self.acp.firewallStatus()));
    }
}


// POST /firewall/rule-add and /firewall/rules/{id}/delete: manage operator firewall rules.
pub struct FirewallRuleAddHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: FirewallRuleAddHandler, ctx: Context): Response {
        let auth = ctx.request.headers.get("authorization") ?? "";
        let kind = json.stringField(ctx.request.body, "frMatchKind");
        let value = json.stringField(ctx.request.body, "frMatchValue");
        let path = json.stringField(ctx.request.body, "frPath");
        let action = json.stringField(ctx.request.body, "frAction");
        let classify = json.stringField(ctx.request.body, "frClassify");
        let _ = self.acp.addFirewallRule(kind, value, path, action, classify, auth);
        return await ds_response.patch(firewallRulesPanel(self.acp.firewallRules()));
    }
}

pub struct FirewallRuleDeleteHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: FirewallRuleDeleteHandler, ctx: Context): Response {
        let auth = ctx.request.headers.get("authorization") ?? "";
        let id = ctx.param("id");
        let _ = self.acp.deleteFirewallRule(id, auth);
        return await ds_response.patch(firewallRulesPanel(self.acp.firewallRules()));
    }
}


// GET /report/violations.csv: forward the server's CSV so the console can offer a same-origin download.
pub struct ReportCsvHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: ReportCsvHandler, ctx: Context): Response {
        let csv = self.acp.violationCsv();
        return response.Response.ok(csv)
            .setHeader("content-type", "text/csv")
            .setHeader("content-disposition", "attachment; filename=\"violations.csv\"");
    }
}
