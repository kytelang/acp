import web.routing;
import web.response;
import serde.json;
import string;
import list;
import ds_response;
import Features.Dashboard.Shared.acp_client;
import Features.Dashboard.views.dashboard;

// POST /grc/create: read the operator's datastar signals, forward a clean body to acp-server (which
// signs the record and stores it in the configured database), and patch the result.
pub struct CreateGrcHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: CreateGrcHandler, ctx: Context): Response {
        let acp = self.acp.withTenant(json.stringField(ctx.request.body, "tenant"));
        let auth = ctx.request.headers.get("authorization") ?? "";
        let kind = json.stringField(ctx.request.body, "grcKind");
        let subject = json.stringField(ctx.request.body, "grcSubject");
        let title = json.stringField(ctx.request.body, "grcTitle");
        let status = json.stringField(ctx.request.body, "grcStatus");
        let body = json.stringField(ctx.request.body, "grcBody");
        // grcLinks is an operator-friendly comma-separated list of decision ids. We turn it into an
        // advisory JSON array; the server reconciles each id against the ledger and never trusts it.
        let links = json.stringField(ctx.request.body, "grcLinks");
        let refs = "[";
        let parts = string.split(links, ",");
        let n = 0;
        for (p in 0..parts.size()) {
            let id = string.trim(parts.get(p) ?? "");
            if (string.eql(id, "")) { continue; }
            if (n > 0) { refs = refs + ","; }
            refs = refs + "{\"type\":\"decision\",\"id\":\"" + id + "\"}";
            n = n + 1;
        }
        refs = refs + "]";
        let res = acp.createGrc(kind, subject, title, status, body, refs, auth);
        return await ds_response.patch(grcCreateResult(res));
    }
}


// POST /grc/{id}/to/{status}: advance a governance record status (re-signed server-side), then patch
// the refreshed GRC panel (B2).
pub struct GrcStatusHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: GrcStatusHandler, ctx: Context): Response {
        let acp = self.acp.withTenant(json.stringField(ctx.request.body, "tenant"));
        let auth = ctx.request.headers.get("authorization") ?? "";
        let id = ctx.param("id");
        let status = ctx.param("status");
        let _ = acp.updateGrcStatus(id, status, auth);
        return await ds_response.patch(grcPanel(acp.grcRows()));
    }
}


// POST /grc/assess: guided EU AI Act assessment wizard. Reads the screening checkbox signals, builds
// the answers JSON, and forwards to acp-server which computes the tier and control checklist.
pub struct CreateAssessmentHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: CreateAssessmentHandler, ctx: Context): Response {
        let acp = self.acp.withTenant(json.stringField(ctx.request.body, "tenant"));
        let auth = ctx.request.headers.get("authorization") ?? "";
        let subject = json.stringField(ctx.request.body, "asSubject");
        let title = json.stringField(ctx.request.body, "asTitle");
        let assignee = json.stringField(ctx.request.body, "asAssignee");
        let flags = list.List<string>();
        flags.push("prohibited_practice"); flags.push("safety_component");
        flags.push("biometric_identification"); flags.push("critical_infrastructure");
        flags.push("employment_or_education"); flags.push("essential_services");
        flags.push("law_enforcement"); flags.push("interacts_with_humans");
        flags.push("generates_content");
        let bodyV = json.parse(ctx.request.body);
        let answers = "{";
        let n = 0;
        for (i in 0..flags.size()) {
            let key = flags.get(i) ?? "";
            // datastar checkboxes post a JSON boolean; a <select> posts the string "true". Accept both.
            let node = json.get(bodyV, "as_" + key);
            let on = (json.asBool(node) ?? false) || string.eql(json.asString(node) ?? "", "true");
            if (n > 0) { answers = answers + ","; }
            answers = answers + "\"" + key + "\":" + (on ? "true" : "false");
            n = n + 1;
        }
        answers = answers + "}";
        let res = acp.assessGrc(subject, title, answers, assignee, "", auth);
        return await ds_response.patch(grcCreateResult(res));
    }
}

// POST /grc/{id}/assign: set assignee (workflow metadata), then patch the refreshed GRC panel.
