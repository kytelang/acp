import web.routing;
import web.response;
import serde.json;
import string;
import ds_response;
import Features.Dashboard.Shared.acp_client;
import Features.Dashboard.views.dashboard;

// POST /apps/register and /agents/register: read the operator's datastar signals, forward a clean
// body to acp-server (which stores the record in the configured database), and patch the result.
pub struct RegisterAppHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: RegisterAppHandler, ctx: Context): Response {
        let acp = self.acp.withTenant(json.stringField(ctx.request.body, "tenant"));
        let auth = ctx.request.headers.get("authorization") ?? "";
        let name = json.stringField(ctx.request.body, "appName");
        let owner = json.stringField(ctx.request.body, "appOwner");
        let res = acp.registerApp(name, owner, auth);
        return await ds_response.patch(appRegisterResult(res));
    }
}

pub struct RegisterAgentHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: RegisterAgentHandler, ctx: Context): Response {
        let acp = self.acp.withTenant(json.stringField(ctx.request.body, "tenant"));
        let auth = ctx.request.headers.get("authorization") ?? "";
        let appId = json.stringField(ctx.request.body, "agentAppId");
        let name = json.stringField(ctx.request.body, "agentName");
        let owner = json.stringField(ctx.request.body, "agentOwner");
        let deps = json.stringField(ctx.request.body, "agentDeps");
        // deps is an optional comma-separated dependency list -> metadata_json {"deps":[...]}.
        let meta = "{\"deps\":[";
        let parts = string.split(deps, ",");
        let n = 0;
        for (p in 0..parts.size()) {
            let d = string.trim(parts.get(p) ?? "");
            if (string.eql(d, "")) { continue; }
            if (n > 0) { meta = meta + ","; }
            meta = meta + "\"" + d + "\"";
            n = n + 1;
        }
        meta = meta + "]}";
        let res = acp.registerAgent(appId, name, owner, meta, auth);
        return await ds_response.patch(agentRegisterResult(res));
    }
}


// POST /agents/{id}/deactivate: revoke a registered agent via the control plane, then patch the
// refreshed agents panel (B1).
pub struct DeactivateAgentHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: DeactivateAgentHandler, ctx: Context): Response {
        let acp = self.acp.withTenant(json.stringField(ctx.request.body, "tenant"));
        let auth = ctx.request.headers.get("authorization") ?? "";
        let id = ctx.param("id");
        let _ = acp.deactivateAgent(id, auth);
        return await ds_response.patch(agentsPanel(acp.agentsRows()));
    }
}

// #2: auto risk-tiering. Derive the EU AI Act tier from an agent's tool bindings and file a signed
// assessment; patch the governance-records panel so the new assessment appears.
pub struct AutoAssessAgentHandler impl RouteHandler {
