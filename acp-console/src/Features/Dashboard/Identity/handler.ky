        let auth = ctx.request.headers.get("authorization") ?? "";
        let id = ctx.param("id");
        let _ = acp.autoAssessAgent(id, auth);
        return await ds_response.patch(grcPanel(acp.grcRows()));
    }
}

// A3: register a model in the registry (B3 admission scan runs server-side).
pub struct RegisterModelHandler impl RouteHandler {
    acp: AcpClient,
    init(acp: AcpClient) { self.acp = acp; }
    async fn serve(self: RegisterModelHandler, ctx: Context): Response {
        let acp = self.acp.withTenant(json.stringField(ctx.request.body, "tenant"));
        let auth = ctx.request.headers.get("authorization") ?? "";
        let name = json.stringField(ctx.request.body, "modelName");
        let provider = json.stringField(ctx.request.body, "modelProvider");
        let version = json.stringField(ctx.request.body, "modelVersion");
        let res = acp.registerModel(name, provider, version, auth);
        return await ds_response.patch(modelCreateResult(res));
    }
}

// A3: record a vendor with a risk score.
