        {if (res.ok) { <span class="badge ok">registered</span> } else { <span class="badge bad">rejected</span> }}
        <span class="dim">{res.message}</span>
    </div>;
}
pub fn agentRegisterResult(res: DeployResult): Html {
    return <div id="agentresult" class="deploystatus">
        {if (res.ok) { <span class="badge ok">registered</span> } else { <span class="badge bad">rejected</span> }}
        <span class="mono dim">{res.message}</span>
    </div>;
}


// Governance records (fragment #grc): signed operator documents (assessments, risk, model cards, ...).
pub fn grcPanel(rows: list.List<GrcRow>): Html {
    return <div id="grc">
        {if (rows.size() == 0) {
            <p class="empty">No governance records yet. Create one below.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Kind</th><th>Subject</th><th>Tier</th><th>Stage</th><th>Assignee</th><th>Controls</th><th>Signed</th><th>Linked evidence</th><th>Comments</th><th>Advance</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let r = rows.get(i) ?? GrcRow("", "", "", "", "", false, 0, 0, "", "", "", 0, 0, list.List<GrcControl>(), list.List<GrcComment>());
                        <tr>
                            <td><span class="badge ver">{r.kind}</span><div class="mono dim" style="font-size:.7rem">{r.id}</div></td>
                            <td class="strong">{r.subject}<div class="dim">{r.title}</div></td>
                            <td>{if (string.eql(r.tier, "")) { <span class="dim">-</span> } else { <span class={r.tier == "high" || r.tier == "unacceptable" ? "badge bad" : "badge ver"}>{r.tier}</span> }}</td>
                            <td><span class="badge warn">{string.eql(r.stage, "") ? r.status : r.stage}</span></td>
                            <td>{string.eql(r.assignee, "") ? <span class="dim">unassigned</span> : <span>{r.assignee}</span>}</td>
                            <td>
                                {if (r.controlsTotal == 0) { <span class="dim">-</span> } else {
                                    <details>
                                        <summary><span class={r.controlsDone == r.controlsTotal ? "badge ok" : "badge warn"}>{r.controlsDone}/{r.controlsTotal} controls</span></summary>
                                        {for (j in 0..r.controls.size()) {
                                            let c = r.controls.get(j) ?? GrcControl("", "", false);
                                            <div class="row" style="gap:.4rem;align-items:center;margin:.15rem 0">
                                                {if (c.done) { <span class="badge ok">done</span> } else { <span class="badge">open</span> }}
                                                <span class="mono dim">{c.controlId}</span>
                                                <span>{c.title}</span>
                                                {if (c.done) {
                                                    <button class="btn" data-on:click={"@post('/grc/" + r.id + "/control/" + c.controlId + "/undone')"}>Reopen</button>
                                                } else {
                                                    <button class="btn ok" data-on:click={"@post('/grc/" + r.id + "/control/" + c.controlId + "/done')"}>Mark done</button>
                                                }}
                                            </div>
                                        }}
                                    </details>
                                }}
                            </td>
                            <td>{if (r.verified) { <span class="badge ok">verified</span> } else { <span class="badge bad">unverified</span> }}</td>
                            <td>{if (r.totalRefs == 0) { <span class="dim">0/0</span> } else { <span class={r.verifiedRefs == r.totalRefs ? "badge ok" : "badge warn"}>{r.verifiedRefs}/{r.totalRefs} verified</span> }}</td>
                            <td>{if (r.comments.size() == 0) { <span class="dim">-</span> } else {
                                <details><summary><span class="badge ver">{r.comments.size()} comments</span></summary>
                                    {for (m in 0..r.comments.size()) {
                                        let cm = r.comments.get(m) ?? GrcComment("", "");
                                        <div style="margin:.15rem 0"><span class="mono dim">{cm.author}</span>: {cm.body}</div>
                                    }}
                                </details>
                            }}</td>
                            <td>
                                {if (string.eql(r.kind, "use-case")) {
                                    <span class="actcol">
                                        {if (string.eql(r.status, "proposed") || string.eql(r.status, "open")) { <button class="btn" data-on:click={"@post('/grc/" + r.id + "/usecase/assessed')"}>Assess</button> } else { <span></span> }}
                                        {if (string.eql(r.status, "assessed")) { <button class="btn ok" data-on:click={"@post('/grc/" + r.id + "/usecase/approved')"}>Approve</button> } else { <span></span> }}
                                        {if (string.eql(r.status, "approved")) { <button class="btn ok" data-on:click={"@post('/grc/" + r.id + "/usecase/deployed')"}>Deploy</button> } else { <span></span> }}
                                        {if (string.eql(r.status, "retired")) { <span class="dim">retired</span> } else { <button class="btn no" data-on:click={"@post('/grc/" + r.id + "/usecase/retired')"}>Retire</button> }}
                                    </span>
                                } else {
                                    <span class="actcol">
                                        <button class="btn" data-on:click={"@post('/grc/" + r.id + "/to/in-review')"}>Review</button>
                                        <button class="btn ok" data-on:click={"@post('/grc/" + r.id + "/to/approved')"}>Approve</button>
                                        <button class="btn no" data-on:click={"@post('/grc/" + r.id + "/to/closed')"}>Close</button>
                                    </span>
                                }}
                            </td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

pub fn grcCreateResult(res: DeployResult): Html {
    return <div id="grcresult" class="deploystatus">
        {if (res.ok) { <span class="badge ok">created</span> } else { <span class="badge bad">rejected</span> }}
        <span class="dim">{res.message}</span>
    </div>;
}


// A3/B3: registered models with their admission scan-status badge.
pub fn modelsPanel(rows: list.List<ModelRow>): Html {
    return <div id="models">
        {if (rows.size() == 0) {
            <p class="empty">No models registered yet.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Model</th><th>Provider</th><th>Version</th><th>Scan</th><th>ATLAS</th><th>AI-BOM</th><th>ID</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let m = rows.get(i) ?? ModelRow("", "", "", "", "unscanned", false, "");
                        <tr>
                            <td class="strong">{m.name}</td>
                            <td>{m.provider}</td>
                            <td>{m.version}</td>
                            <td>{if (string.eql(m.scanStatus, "clean")) { <span class="badge ok">clean</span> } else { if (string.eql(m.scanStatus, "unscanned")) { <span class="badge">unscanned</span> } else { <span class="badge bad">{m.scanStatus}</span> } }}</td>
                            <td>{if (string.eql(m.atlas, "")) { <span class="dim">-</span> } else { <span class="badge warn mono" title="MITRE ATLAS techniques">{m.atlas}</span> }}</td>
                            <td>{if (m.hasBom) { <span class="badge ver">signed</span> } else { <span class="dim">-</span> }}</td>
                            <td class="mono dim">{m.id}</td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

pub fn postMarketPanel(pm: PostMarket): Html {
    return <div id="postmarket">
        <div class="row" style="gap:1.5rem;flex-wrap:wrap">
            <div><div class="stat-n">{`${pm.totalEvents}`}</div><div class="stat-l">events</div></div>
            <div><div class="stat-n">{`${pm.blocks}`}</div><div class="stat-l">blocks</div></div>
            <div><div class="stat-n">{`${pm.driftClasses}`}</div><div class="stat-l">drift classes</div></div>
            <div><div class="stat-n">{pm.redteam}</div><div class="stat-l">red-team</div></div>
        </div>
        <p class="hint" style="margin-top:.6rem">Assembled from runtime evidence, not a questionnaire. Snapshot to store a signed copy.</p>
    </div>;
}

pub fn authorResultPanel(res: DeployResult): Html {
    return <div id="authorresult">
        {if (res.ok) { <pre class="mono" style="background:var(--panel);padding:.7rem;border-radius:8px;white-space:pre-wrap;font-size:.8rem">{res.message}</pre> } else { <span class="badge bad">{res.message}</span> }}
    </div>;
}

pub fn suggestResultPanel(res: DeployResult): Html {
    return <div id="suggestresult">
        {if (res.ok) { <span class="badge ok">{res.message}</span> } else { <span class="badge bad">{res.message}</span> }}
    </div>;
}

pub fn policySuggestPanel(info: SuggestInfo): Html {
    return <div id="policysuggest">
        {if (info.proposedRules == 0) {
            <p class="empty">No observed traffic yet. Run agents through a PEP (shadow mode is ideal), then a least-privilege proposal appears here.</p>
        } else {
            <div>
                <p class="hint">{`Synthesised from ${info.observed} observed decisions: a default-deny policy with ${info.proposedRules} rule(s) permitting exactly what was seen.`}{" "}{if (string.eql(info.wouldBlock, "")) { <span class="badge ok">blocks nothing observed</span> } else { <span class="badge bad">{`would block: ${info.wouldBlock}`}</span> }}</p>
                <pre class="mono" style="max-height:20rem;overflow:auto;background:var(--panel);padding:.8rem;border-radius:8px;white-space:pre-wrap">{info.proposed}</pre>
                <div class="row" style="margin-top:.8rem;gap:.5rem">
                    <button class="btn primary" data-on:click="@post('/policy/approve-suggestion')">Approve and deploy (signed)</button>
                    <span class="dim" style="font-size:.8rem">deploys via the signed policy store; requires your PolicyAdmin identity</span>
                </div>
                <div id="suggestresult" style="margin-top:.6rem"></div>
            </div>
        }}
    </div>;
}

pub fn assuranceResultPanel(id: string, res: DeployResult): Html {
    return <div id={id}>
        {if (res.ok) { <span class="badge ok">{res.message}</span> } else { <span class="badge bad">{res.message}</span> }}
    </div>;
}

pub fn trustPanel(summary: string): Html {
    return <div id="trust">
        {if (string.eql(summary, "")) { <p class="empty">connecting to acp-server&#8230;</p> } else {
            <div><p class="mono">{summary}</p><p class="hint">Signed at <span class="mono">GET /trust</span>; a client verifies it with the public key alone.</p></div>
        }}
    </div>;
}

pub fn oversightPanel(rows: list.List<OversightRow>): Html {
    return <div id="oversight">
        {if (rows.size() == 0) {
            <p class="empty">No resolved approvals yet, so there is nothing to assess.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Approver</th><th>Decisions</th><th>Approve rate</th><th>Median decision</th><th>Oversight</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let o = rows.get(i) ?? OversightRow("", false, "0%", 0, 0, "");
                        <tr>
                            <td class="strong">{o.approver}</td>
                            <td>{`${o.total}`}</td>
                            <td>{o.approveRate}</td>
                            <td>{`${o.medianMs} ms`}</td>
                            <td>{if (o.flagged) { <span class="badge bad" title={o.reasons}>weakness: {o.reasons}</span> } else { <span class="badge ok">effective</span> }}</td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

pub fn vendorsPanel(rows: list.List<VendorRow>): Html {
    return <div id="vendors">
        {if (rows.size() == 0) {
            <p class="empty">No vendors recorded.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Vendor</th><th>Risk band</th><th>Review</th><th>Action</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let v = rows.get(i) ?? VendorRow("", "", "{}", "", false);
                        <tr><td class="strong">{v.name}</td><td>{if (string.eql(v.band, "critical") || string.eql(v.band, "high")) { <span class="badge bad">{v.band}</span> } else { if (string.eql(v.band, "medium")) { <span class="badge warn">{v.band}</span> } else { if (string.eql(v.band, "")) { <span class="dim">-</span> } else { <span class="badge ok">{v.band}</span> } } }}</td><td>{if (v.overdue) { <span class="badge bad">review overdue</span> } else { <span class="badge ok">current</span> }}</td><td><button class="btn" data-on:click={"@post('/vendors/" + v.id + "/review')"}>Re-review</button></td></tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

pub fn modelCreateResult(res: DeployResult): Html {
    return <div id="modelresult" class="deploystatus">
        {if (res.ok) { <span class="badge ok">done</span> } else { <span class="badge bad">rejected</span> }}
        <span class="dim">{res.message}</span>
    </div>;
}

// A4: loaded signed control packs (version + frameworks + re-verified state).
pub fn packsPanel(rows: list.List<PackRow>): Html {
    return <div id="packs">
        {if (rows.size() == 0) {
            <p class="empty">No control packs loaded. Load the built-in framework packs to seed the control library.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Pack</th><th>Version</th><th>Frameworks</th><th>Controls</th><th>Signature</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let p = rows.get(i) ?? PackRow("", "", "", 0, false);
                        <tr>
                            <td class="mono">{p.id}</td>
                            <td>{p.version}</td>
                            <td><span class="badge ver">{p.frameworks}</span></td>
                            <td>{p.controls}</td>
                            <td>{if (p.verified) { <span class="badge ok">verified</span> } else { <span class="badge bad">unverified</span> }}</td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

// A6: regulator-facing framework report (print-friendly). Rendered into #frameworkreport.
pub fn frameworkReportPanel(rep: FrameworkReport): Html {
    return <div id="frameworkreport">
        {if (string.eql(rep.framework, "") || rep.total == 0) {
            <p class="empty">Choose a framework above to build its report.</p>
        } else {
            <div class="fwreport">
                <div class="fwreport-h">
                    <h2>{frameworkTitle(rep.framework)}</h2>
                    <div class="fwreport-stats">
                        <span class="badge ver">{rep.satisfied}/{rep.total} controls satisfied</span>
                        <span class="badge">coverage {pctNum(rep.coverage)}%</span>
                        <span class="badge">{rep.evVerified}/{rep.evTotal} linked evidence verified</span>
                        <span class={rep.breaches > 0 ? "badge bad" : "badge ok"}>{rep.breaches} breaches</span>
                    </div>
                </div>
                <table class="tbl">
                    <thead><tr><th>Control</th><th>Title</th><th>Status</th></tr></thead>
                    <tbody>
                        {for (i in 0..rep.controls.size()) {
                            let c = rep.controls.get(i) ?? ControlStatus("", "", "");
                            <tr>
                                <td class="mono">{c.controlId}</td>
                                <td>{c.title}</td>
                                <td>{if (string.eql(c.status, "satisfied")) { <span class="badge ok">satisfied</span> } else { if (string.eql(c.status, "in-progress")) { <span class="badge warn">in-progress</span> } else { <span class="badge bad">not addressed</span> } }}</td>
                            </tr>
                        }}
                    </tbody>
                </table>
            </div>
        }}
    </div>;
}

// B4: red-team runs over time (a signed attestation per run). Failing runs are flagged.
pub fn redteamPanel(rows: list.List<RedteamRun>): Html {
    return <div id="redteam">
        {if (rows.size() == 0) {
            <p class="empty">No red-team runs yet. Run one to start the time series.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Run</th><th>Catch rate</th><th>Min catch</th><th>Result</th><th>Signature</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let r = rows.get(i) ?? RedteamRun("", "", 0.0, 0.0, false);
                        <tr>
                            <td class="mono dim">{r.id}</td>
                            <td>{pctNum(r.catchRate)}%</td>
                            <td>{pctNum(r.minCatch)}%</td>
                            <td>{if (string.eql(r.status, "passed")) { <span class="badge ok">passed</span> } else { <span class="badge bad">FAILED</span> }}</td>
                            <td>{if (r.verified) { <span class="badge ok">verified</span> } else { <span class="badge bad">unverified</span> }}</td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

// G2: structured risk register (score = likelihood x impact, with a severity band).
pub fn riskPanel(rows: list.List<RiskRow>): Html {
    return <div id="risks">
        {if (rows.size() == 0) {
            <p class="empty">No risks recorded.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Subject</th><th>Risk</th><th>Likelihood</th><th>Impact</th><th>Score</th><th>Severity</th><th>Treatment</th><th>Status</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let r = rows.get(i) ?? RiskRow("", "", "", "", "", "", 0, "", "");
                        <tr>
                            <td class="strong">{r.subject}</td>
                            <td>{r.title}</td>
                            <td>{r.likelihood}</td>
                            <td>{r.impact}</td>
                            <td>{r.score}</td>
                            <td>{if (string.eql(r.band, "critical") || string.eql(r.band, "high")) { <span class="badge bad">{r.band}</span> } else { if (string.eql(r.band, "medium")) { <span class="badge warn">{r.band}</span> } else { if (string.eql(r.band, "")) { <span class="dim">-</span> } else { <span class="badge ok">{r.band}</span> } } }}</td>
                            <td>{r.treatment}</td>
                            <td>
                                <span class="badge warn">{r.status}</span>
                                {if (string.eql(r.status, "open")) { <button class="btn" data-on:click={"@post('/grc/" + r.id + "/to/mitigating')"}>Mitigate</button> } else { <button class="btn ok" data-on:click={"@post('/grc/" + r.id + "/to/closed')"}>Close</button> }}
                            </td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

// G3: model cards joined to their model, use-case and risk (resolved link badges).
pub fn modelCardsPanel(rows: list.List<ModelCardRow>): Html {
    return <div id="modelcards">
        {if (rows.size() == 0) {
            <p class="empty">No model cards yet.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Subject</th><th>Card</th><th>Model</th><th>Use-case</th><th>Risk</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let c = rows.get(i) ?? ModelCardRow("", "", "", "", "", "", false, false, false);
                        <tr>
                            <td class="strong">{c.subject}</td>
                            <td>{c.title}</td>
                            <td>{if (c.modelOk) { <span class="badge ok" title={c.modelId}>linked</span> } else { <span class="badge bad">unresolved</span> }}</td>
                            <td>{if (c.ucOk) { <span class="badge ok" title={c.useCaseId}>linked</span> } else { <span class="badge bad">unresolved</span> }}</td>
                            <td>{if (c.riskOk) { <span class="badge ok" title={c.riskId}>linked</span> } else { <span class="badge bad">unresolved</span> }}</td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

// F3: classifier drift (per-class live rate vs baseline; drifted flagged).
pub fn driftPanel(rows: list.List<DriftRow>): Html {
    return <div id="drift">
        {if (rows.size() == 0) {
            <p class="empty">No drift telemetry yet. Enforcement points report per-class hit-rates.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Class</th><th>Live rate</th><th>Baseline</th><th>Status</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let d = rows.get(i) ?? DriftRow("", 0.0, 0.0, false);
                        <tr>
                            <td class="strong">{d.cls}</td>
                            <td>{d.rate}</td>
                            <td>{d.baseline}</td>
                            <td>{if (d.drifted) { <span class="badge bad">drifted</span> } else { <span class="badge ok">stable</span> }}</td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

// F3: data-class -> tool lineage (counts only, no raw values).
pub fn lineagePanel(rows: list.List<LineageRow>): Html {
    return <div id="lineage">
        {if (rows.size() == 0) {
            <p class="empty">No lineage telemetry yet.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Data class</th><th>Reached tool</th><th>Count</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let e = rows.get(i) ?? LineageRow("", "", 0);
                        <tr><td><span class="badge ver">{e.dataClass}</span></td><td class="mono">{e.tool}</td><td>{e.count}</td></tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

// R1: live tenant switcher. Changing the select re-issues the SSE @get with the new tenant signal,
// so every panel re-scopes. Options come from GET /tenants.
pub fn tenantSwitcher(tenants: list.List<string>, current: string): Html {
    return <div id="tenant">tenant:
        <select data-bind="tenant" data-on:change="@get('/sse/metrics')" style="margin-left:.3rem">
            {for (i in 0..tenants.size()) {
                let t = tenants.get(i) ?? "default";
                if (string.eql(t, current)) { <option value={t} selected="selected">{t}</option> } else { <option value={t}>{t}</option> }
            }}
        </select>
    </div>;
}


// Agent configuration: what every workstation agent pulls from this control plane, and how to connect
// one. The config is org-wide (per-tenant); per-user differences come from the policy group rules.
pub fn agentConfigPanel(c: AgentConfig): Html {
    return <div id="agentconfig">
        <div class="card"><div class="card-h">Connect a workstation<span class="sub">one URL; policy, firewall, rules and groups are all fetched from the control plane</span></div>
            <div class="card-b">
                <p class="hint">Enrol an agent on the Agents page to get its id and one-time token, then run the workstation agent. The single{" "}<span class="mono">--control-plane</span>{" "}URL expands into every fetch it needs.</p>
                <pre class="mono" style="background:var(--panel);padding:.8rem;border-radius:8px;white-space:pre-wrap;overflow-x:auto;font-size:.82rem">{`acp-agent run --control-plane ${c.base} --firewall 127.0.0.1:8080 --agent-id AGENT_ID --agent-token TOKEN --principal USER@CORP`}</pre>
                <p class="hint">Replace AGENT_ID and TOKEN with the values from enrolling the agent, and USER@CORP with the workstation user. Directory groups are resolved automatically from the control plane, so{" "}<span class="mono">group</span>{" "}policy rules apply without per-user setup.</p>
            </div></div>
        <div class="card"><div class="card-h">Signed policy agents enforce<span class="sub">fetched from GET /policy-store/signed and signature-verified before enforcing</span></div>
            <div class="card-b">
                <div class="row" style="gap:1.5rem;flex-wrap:wrap;align-items:center">
                    <div><div class="rep-k">Version</div><div><span class="badge ver">{c.policyVersion}</span></div></div>
                    <div><div class="rep-k">Deployed by</div><div class="strong">{string.eql(c.policyAuthor, "") ? "unknown" : c.policyAuthor}</div></div>
                    <div style="min-width:240px"><div class="rep-k">Hash</div><div class="mono dim" style="font-size:.72rem;word-break:break-all">{string.eql(c.policyHash, "") ? "no policy deployed" : c.policyHash}</div></div>
                </div>
                <p class="hint" style="margin-top:.8rem">Deploy or change it on the{" "}<b>Policy</b>{" "}page. Every agent re-fetches within 30 seconds; an agent may pin the signing key with{" "}<span class="mono">--policy-pubkey</span>{" "}so only this key is trusted.</p>
            </div></div>
        <div class="card"><div class="card-h">What every agent fetches<span class="sub">org-wide config; per-user differences come from policy group rules</span></div>
            <div class="card-b">
                <table class="tbl">
                    <thead><tr><th>Config</th><th>Endpoint</th><th>Notes</th></tr></thead>
                    <tbody>
                        <tr><td class="strong">Authorization policy</td><td class="mono dim">GET /policy-store/signed</td><td>signed, signature-verified, refreshed every 30s</td></tr>
                        <tr><td class="strong">Content firewall</td><td class="mono dim">GET /firewall/config</td><td>{c.firewallEnabled ? <span class="badge ok">enabled</span> : <span class="badge bad">disabled</span>}{" "}{c.firewallModel ? <span class="badge ver">ML model</span> : <span class="dim">signatures only</span>}</td></tr>
                        <tr><td class="strong">Interception rules</td><td class="mono dim">GET /firewall/rules</td><td>which traffic to intercept and how</td></tr>
                        <tr><td class="strong">Principal groups</td><td class="mono dim">GET /principal/groups</td><td>from the IdP directory; drives group-based policy</td></tr>
                    </tbody>
                </table>
            </div></div>
    </div>;
}


// Agent-config editor: save result + a display of the stored config.
pub fn agentConfigResultPanel(res: DeployResult): Html {
    return <div id="acresult" class="deploystatus">
        {if (res.ok) { <span class="badge ok">saved</span> } else { <span class="badge bad">failed</span> }}
        <span class="dim">{res.message}</span>
    </div>;
}

pub fn agentConfigLoadedPanel(id: string, cfg: string): Html {
    return <div id="acloaded">
        {if (string.eql(cfg, "")) { <p class="hint">No stored config for that agent id (defaults apply until you save).</p> } else {
            <div><p class="hint">Stored config for {id}:</p><pre class="mono" style="background:var(--panel);padding:.7rem;border-radius:8px;white-space:pre-wrap;overflow-x:auto;font-size:.8rem">{cfg}</pre></div>
        }}
    </div>;
}
