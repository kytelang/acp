import string;
import list;
import Features.Dashboard.Shared.acp_client;

// Overview stat tiles plus a verdict-distribution bar (live-patched fragment #metrics). Driven
// straight from acp-server's /report, so every figure is re-derivable from the signed ledger.
pub fn metricsPanel(r: AcpReport): Html {
    let tot = r.allows + r.denies + r.stepUps + r.shadows;
    let aw = tot - tot; let dw = tot - tot; let sw = tot - tot; let hw = tot - tot;
    if (tot > 0) {
        aw = (r.allows * 100) / tot;
        dw = (r.denies * 100) / tot;
        sw = (r.stepUps * 100) / tot;
        hw = (r.shadows * 100) / tot;
    }
    let awS = `${aw}`; let dwS = `${dw}`; let swS = `${sw}`; let hwS = `${hw}`;
    let covPct = r.coverage * 100.0;
    return <div id="metrics">
        {if (!r.reachable) {
            <p class="empty">acp-server unreachable. Start it on 127.0.0.1:8787.</p>
        } else {
            <div>
                <div class="stats">
                    <div class="stat"><div class="stat-k">Records</div><div class="stat-v">{`${r.records}`}</div></div>
                    <div class="stat"><div class="stat-k">Decisions</div><div class="stat-v">{`${r.decisions}`}</div></div>
                    <div class="stat"><div class="stat-k">Coverage</div><div class="stat-v">{`${covPct}`}<span class="dim" style="font-size:1rem">%</span></div></div>
                    <div class="stat"><div class="stat-k">Denied</div><div class="stat-v danger">{`${r.denies}`}</div></div>
                    <div class="stat"><div class="stat-k">Step-up</div><div class="stat-v warn">{`${r.stepUps}`}</div></div>
                </div>
                <div class="barwrap">
                    <div class="barlbl"><span>Verdict distribution</span><span class="dim">{`${tot}`} decisions</span></div>
                    <div class="bar">
                        <div class="barseg allow" style={"width:" + awS + "%"}></div>
                        <div class="barseg step" style={"width:" + swS + "%"}></div>
                        <div class="barseg shadow" style={"width:" + hwS + "%"}></div>
                        <div class="barseg deny" style={"width:" + dwS + "%"}></div>
                    </div>
                    <div class="barkey">
                        <span><i class="dot allow"></i>allow {`${r.allows}`}</span>
                        <span><i class="dot step"></i>step-up {`${r.stepUps}`}</span>
                        <span><i class="dot shadow"></i>shadow {`${r.shadows}`}</span>
                        <span><i class="dot deny"></i>deny {`${r.denies}`}</span>
                    </div>
                </div>
            </div>
        }}
    </div>;
}

// Small helper: a healthy/degraded pill.
fn healthPill(ok: bool, okText: string, badText: string): Html {
    if (ok) { return <span class="badge ok">{okText}</span>; }
    return <span class="badge bad">{badText}</span>;
}

// Control-plane integrity (fragment #health): ledger re-derivation, dead-man's-switch, spike
// detector and the self-governance meta-audit log. All from acp-server's verifiable endpoints.
pub fn healthPanel(h: HealthStatus): Html {
    return <div id="health">
        {if (!h.reachable) {
            <p class="empty">acp-server unreachable.</p>
        } else {
            <div class="stats">
                <div class="stat">
                    <div class="stat-k">Ledger integrity</div>
                    <div style="margin-top:.5rem">{healthPill(h.ledgerOk, "verified", "FAILED")}</div>
                    <div class="dim" style="margin-top:.4rem;font-size:.78rem">{h.ledgerDetail}</div>
                </div>
                <div class="stat">
                    <div class="stat-k">Proxy liveness</div>
                    <div style="margin-top:.5rem">{healthPill(h.liveHealthy, "all live", "gaps")}</div>
                    <div class="dim" style="margin-top:.4rem;font-size:.78rem">{`${h.gaps}`} silent proxy gap(s)</div>
                </div>
                <div class="stat">
                    <div class="stat-k">Spike alerts</div>
                    <div style="margin-top:.5rem">{healthPill(h.alertsHealthy, "quiet", "tripped")}</div>
                    <div class="dim" style="margin-top:.4rem;font-size:.78rem">{`${h.tripped}`} event kind(s) spiking</div>
                </div>
                <div class="stat">
                    <div class="stat-k">Self-governance log</div>
                    <div style="margin-top:.5rem">{if (h.metaConfigured) {
                        if (h.metaVerified) { <span class="badge ok">verified</span> } else { <span class="badge bad">unverified</span> }
                    } else { <span class="badge warn">off</span> }}</div>
                    <div class="dim" style="margin-top:.4rem;font-size:.78rem">{`${h.metaSize}`} meta-audit record(s)</div>
                </div>
            </div>
        }}
    </div>;
}

// A consolidated, printable governance report (fragment #reports): activity, verdict split,
// coverage and ledger integrity in one view an operator can hand to an auditor.
pub fn reportsPanel(r: AcpReport, h: HealthStatus, evidenceCount: int): Html {
    let covPct = r.coverage * 100.0;
    return <div id="reports">
        {if (!r.reachable) {
            <p class="empty">acp-server unreachable.</p>
        } else {
            <div class="repgrid">
                <div class="repcard">
                    <div class="rep-k">Governed decisions</div>
                    <div class="rep-v">{`${r.decisions}`}</div>
                    <div class="dim">{`${r.records}`} total ledger records</div>
                </div>
                <div class="repcard">
                    <div class="rep-k">Policy coverage</div>
                    <div class="rep-v">{`${covPct}`}%</div>
                    <div class="dim">decisions matched to a named rule</div>
                </div>
                <div class="repcard">
                    <div class="rep-k">Denied</div>
                    <div class="rep-v" style="color:var(--bad)">{`${r.denies}`}</div>
                    <div class="dim">{`${r.stepUps}`} sent to human step-up</div>
                </div>
                <div class="repcard">
                    <div class="rep-k">Ledger integrity</div>
                    <div style="margin-top:.4rem">{healthPill(h.ledgerOk, "verified", "FAILED")}</div>
                    <div class="dim">{`${evidenceCount}`} recent decisions shown</div>
                </div>
            </div>
        }}
    </div>;
}

pub fn appsPanel(rows: list.List<AppRow>): Html {
    return <div id="apps">
        {if (rows.size() == 0) {
            <p class="empty">No apps registered.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Team</th><th>Owner</th><th>Agents</th><th>ID</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let r = rows.get(i) ?? AppRow("", "", "", "0");
                        <tr>
                            <td class="strong">{r.name}</td>
                            <td>{r.owner}</td>
                            <td><span class="badge ok">{r.agents}</span></td>
                            <td class="mono dim">{r.id}</td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

pub fn agentsPanel(rows: list.List<AgentRow>): Html {
    return <div id="agents">
        {if (rows.size() == 0) {
            <p class="empty">No agents registered.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Agent</th><th>Belongs to team</th><th>Status</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let r = rows.get(i) ?? AgentRow("", "", false);
                        <tr>
                            <td class="strong">{r.name}</td>
                            <td><span class="badge ok">{r.app}</span></td>
                            <td>{if (r.active) { <span class="badge ok">active</span> } else { <span class="badge bad">revoked</span> }}</td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

pub fn approvalsPanel(rows: list.List<ApprovalRow>): Html {
    return <div id="approvals">
        {if (rows.size() == 0) {
            <p class="empty">No pending approvals.</p>
        } else {
            <div class="alist">
                {for (i in 0..rows.size()) {
                    let r = rows.get(i) ?? ApprovalRow("", "");
                    <div class="arow">
                        <div class="ainfo"><span class="badge warn">step-up</span><span class="atool">{r.tool}</span><span class="aid mono dim">{r.id}</span></div>
                        <div class="abtns">
                            <button class="btn ok" data-on:click={"@post('/approve/" + r.id + "')"}>Approve</button>
                            <button class="btn no" data-on:click={"@post('/deny/" + r.id + "')"}>Deny</button>
                        </div>
                    </div>
                }}
            </div>
        }}
    </div>;
}

pub fn policyPanel(version: string, author: string): Html {
    return <span id="policy" class="sub">
        <span class="badge ver">{version}</span>
        <span class="dim" style="margin:0 .35rem">deployed by</span>
        <span class="strong">{author}</span>
    </span>;
}

fn verdictBadge(v: string): Html {
    if (string.eql(v, "deny")) { return <span class="badge bad">deny</span>; }
    if (string.eql(v, "step_up")) { return <span class="badge warn">step-up</span>; }
    if (string.eql(v, "shadow")) { return <span class="badge ver">shadow</span>; }
    return <span class="badge ok">{v}</span>;
}

// Recent governed decisions (evidence timeline).
pub fn evidencePanel(rows: list.List<EvidenceRow>): Html {
    return <div id="evidence">
        {if (rows.size() == 0) {
            <p class="empty">No decisions recorded yet.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Seq</th><th>Tool</th><th>Resource</th><th>Verdict</th><th>Agent</th><th>Principal</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let r = rows.get(i) ?? EvidenceRow("", "", "", "", "", "");
                        <tr>
                            <td class="mono dim">{r.seq}</td>
                            <td class="strong">{r.tool}</td>
                            <td>{scopeCell(r.resource, "ok")}</td>
                            <td>{verdictBadge(r.verdict)}</td>
                            <td class="mono dim">{r.agent}</td>
                            <td>{scopeCell(r.principal, "warn")}</td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}


// A scoping cell: "any" shown muted, else a coloured badge. Used for agent/principal/resource.
fn scopeCell(val: string, cls: string): Html {
    if (string.eql(val, "any") || string.eql(val, "-") || string.eql(val, "")) {
        return <span class="dim">any</span>;
    }
    return <span class={"badge " + cls}>{val}</span>;
}

// Rules of the deployed policy, per agent / principal / resource / operation (fragment #policyrules).
pub fn policyRulesPanel(rows: list.List<PolicyRuleRow>): Html {
    return <div id="policyrules">
        {if (rows.size() == 0) {
            <p class="empty">No rules in the deployed policy.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Rule</th><th>Agent</th><th>Principal</th><th>Resource</th><th>Op</th><th>Tool</th><th>Effect</th><th>Obligations</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let r = rows.get(i) ?? PolicyRuleRow("", "", "", "", "", "", "", "");
                        <tr>
                            <td class="strong">{r.id}</td>
                            <td>{scopeCell(r.agent, "ver")}</td>
                            <td>{scopeCell(r.principal, "warn")}</td>
                            <td>{scopeCell(r.resource, "ok")}</td>
                            <td class="mono dim">{r.operation}</td>
                            <td class="mono dim">{r.tool}</td>
                            <td>{verdictBadge(r.verdict)}</td>
                            <td class="mono dim">{r.obligations}</td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

// Outcome of a policy deploy (patched into #deployresult after the operator clicks Deploy).
pub fn deployResultPanel(res: DeployResult): Html {
    return <div id="deployresult" class="deploystatus">
        {if (res.ok) {
            <span class="badge ok">deployed</span>
        } else {
            <span class="badge bad">rejected</span>
        }}
        <span class="dim">{res.message}</span>
    </div>;
}


// Live break-glass / kill-switch status (fragment #killstatus).
pub fn killStatusPanel(s: KillStatus): Html {
    return <div id="killstatus">
        {if (s.active) {
            <div class="polrow">
                <span class="badge bad">ENGAGED</span>
                <span class="badge ver">{s.mode}</span>
                <span class="dim">scope</span> <span class="strong">{s.scope}</span>
                <span class="dim">{s.reason}</span>
                {if (s.signed) { <span class="badge ok">signed</span> } else { <span class="badge warn">unsigned</span> }}
            </div>
        } else {
            <div class="polrow"><span class="badge ok">normal</span> <span class="dim">no active break-glass grant</span></div>
        }}
    </div>;
}

// Outcome of an engage/clear action (fragment #killresult).
pub fn killResultPanel(res: DeployResult): Html {
    return <div id="killresult" class="deploystatus">
        {if (res.ok) { <span class="badge ok">done</span> } else { <span class="badge bad">error</span> }}
        <span class="dim">{res.message}</span>
    </div>;
}


// Disposition badge for a registered AI endpoint.
fn dispoBadge(d: string): Html {
    if (string.eql(d, "govern")) { return <span class="badge ok">govern</span>; }
    if (string.eql(d, "block")) { return <span class="badge bad">block</span>; }
    if (string.eql(d, "accept-risk")) { return <span class="badge warn">accept-risk</span>; }
    return <span class="badge ver">{d}</span>;
}

// Registered AI endpoints (fragment #endpoints): the agents and providers under governance.
pub fn endpointsPanel(rows: list.List<EndpointRow>): Html {
    return <div id="endpoints">
        {if (rows.size() == 0) {
            <p class="empty">No AI endpoints registered yet. Add one below.</p>
        } else {
            <table class="tbl">
                <thead><tr><th>Endpoint</th><th>Provider</th><th>Kind</th><th>Disposition</th><th>Reason</th></tr></thead>
                <tbody>
                    {for (i in 0..rows.size()) {
                        let r = rows.get(i) ?? EndpointRow("", "", "", "", "", false);
                        <tr>
                            <td class="strong mono">{r.endpoint}</td>
                            <td><span class="badge ver">{r.provider}</span></td>
                            <td class="mono dim">{r.kind}</td>
                            <td>{dispoBadge(r.disposition)}{if (r.active) { <span></span> } else { <span class="badge dim" style="margin-left:.35rem">expired</span> }}</td>
                            <td class="dim">{r.reason}</td>
                        </tr>
                    }}
                </tbody>
            </table>
        }}
    </div>;
}

// Outcome of registering an endpoint (fragment #endpointresult).
pub fn endpointRegisterResult(res: DeployResult): Html {
    return <div id="endpointresult" class="deploystatus">
        {if (res.ok) { <span class="badge ok">registered</span> } else { <span class="badge bad">rejected</span> }}
        <span class="dim">{res.message}</span>
    </div>;
}


// Outcome of registering an app (fragment #appresult) or an agent (fragment #agentresult).
pub fn appRegisterResult(res: DeployResult): Html {
    return <div id="appresult" class="deploystatus">
        {if (res.ok) { <span class="badge ok">registered</span> } else { <span class="badge bad">rejected</span> }}
        <span class="dim">{res.message}</span>
    </div>;
}
pub fn agentRegisterResult(res: DeployResult): Html {
    return <div id="agentresult" class="deploystatus">
        {if (res.ok) { <span class="badge ok">registered</span> } else { <span class="badge bad">rejected</span> }}
        <span class="mono dim">{res.message}</span>
    </div>;
}
