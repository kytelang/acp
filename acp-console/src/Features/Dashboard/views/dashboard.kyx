// The live metrics fragment. Carries its own id="metrics" so datastar morphs it onto the shell's
// container in place. Returned by the SSE stream; never a full page.
pub fn metricsPanel(reachable: string, posture: string, decisions: string, coverage: string, denies: string, stepUps: string): Html {
    return <div id="metrics">
        <p class="sub"><span class={reachable == "1" ? "dot on" : "dot off"}></span>{reachable == "1" ? "acp-server connected" : "acp-server offline"}</p>
        <div class="grid">
            <div class="card"><div class="k">Posture score</div><div class="v">{posture}</div></div>
            <div class="card"><div class="k">Decisions</div><div class="v">{decisions}</div></div>
            <div class="card"><div class="k">Policy coverage</div><div class="v">{coverage}</div></div>
            <div class="card"><div class="k">Denied</div><div class="v">{denies}</div></div>
            <div class="card"><div class="k">Step-up</div><div class="v">{stepUps}</div></div>
        </div>
    </div>;
}

// Registered apps section (live-patched fragment).
pub fn appsPanel(text: string): Html {
    return <div id="apps" class="card wide"><div class="k">Registered apps</div><div class="line">{text}</div></div>;
}

// Registered agents section.
pub fn agentsPanel(text: string): Html {
    return <div id="agents" class="card wide"><div class="k">Registered agents</div><div class="line">{text}</div></div>;
}

// Current signed policy section.
pub fn policyPanel(text: string): Html {
    return <div id="policy" class="card wide"><div class="k">Deployed policy</div><div class="line">{text}</div></div>;
}

// Pending-approvals inbox: one row per hold with Approve / Deny buttons. datastar posts the action
// to the console, which forwards it to acp-server and patches this fragment back.
pub fn approvalsPanel(rows: list.List<ApprovalRow>): Html {
    return <div id="approvals" class="card wide">
        <div class="k">Pending approvals</div>
        {if (rows.size() == 0) {
            <p class="line sub">no pending approvals</p>
        } else {
            <div class="line">
                {for (i in 0..rows.size()) {
                    let r = rows.get(i) ?? ApprovalRow("", "");
                    <div class="arow">
                        <span class="atool">{r.tool}</span>
                        <span class="aid sub">{r.id}</span>
                        <button class="btn ok" data-on:click={"@post('/approve/" + r.id + "')"}>Approve</button>
                        <button class="btn no" data-on:click={"@post('/deny/" + r.id + "')"}>Deny</button>
                    </div>
                }}
            </div>
        }}
    </div>;
}
