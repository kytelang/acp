# Shipped in the release archive. Mirrors the unit install-server.sh generates inline. The upstream
# and shared-budget DSN come from the EnvironmentFile (/etc/acp/gateway.env). The content firewall
# and its ML model are on by default; remove --content-ml if the model file is not installed.
[Unit]
Description=Varman (ACP) LLM gateway
After=network-online.target
Wants=network-online.target

[Service]
User=acp
Group=acp
EnvironmentFile=/etc/acp/gateway.env
ExecStart=/usr/local/bin/acp-gateway --addr 0.0.0.0:8799 --policy /etc/acp/policy.yaml \
  --upstream ${ACP_UPSTREAM} --budget-pg ${ACP_BUDGET_PG} --content-firewall --content-ml /etc/acp/injection-lr.json
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
