# Copy to deploy/.env and fill in. docker compose reads this automatically.
# NEVER commit deploy/.env with real values.

# Postgres password for the shared-state database (budgets and tool-integrity pins).
ACP_PG_PASSWORD=change-me-strong-password

# Optional: the upstream model API key the gateway brokers (so callers never hold it).
# Wire this into the gateway service if your upstream requires it.
# ACP_UPSTREAM_API_KEY=sk-...
